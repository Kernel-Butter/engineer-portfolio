    <a href="/" class="font-headline-md text-headline-md font-bold tracking-tighter text-primary">
      SYS.ENGINEER
    </a>

    <div class="hidden md:flex items-center gap-8">
      <a href="/#tech-stack-v2" class="text-on-surface-variant font-code-snippet text-code-snippet hover:text-secondary transition-colors duration-300">STK</a>
      <a href="/#projects"      class="text-on-surface-variant font-code-snippet text-code-snippet hover:text-secondary transition-colors duration-300">PRJ</a>
      <a href="/#experience"    class="text-on-surface-variant font-code-snippet text-code-snippet hover:text-secondary transition-colors duration-300">EXP</a>
