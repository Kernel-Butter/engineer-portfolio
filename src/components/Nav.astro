      <a href="/experiments"    class="font-code-snippet text-code-snippet text-tertiary/70 hover:text-tertiary transition-colors duration-300 border border-tertiary/20 px-2 py-0.5 rounded text-[11px] uppercase tracking-widest">LAB</a>
    </div>

    <div class="flex items-center gap-4">
      <div class="hidden md:flex gap-2 text-on-surface-variant">
        <button class="hover:text-secondary transition-colors duration-300">
          <span class="material-symbols-outlined">terminal</span>
