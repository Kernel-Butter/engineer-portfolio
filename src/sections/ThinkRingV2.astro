---
// ThinkRing — Rain World Guardian Halo
// Pure 2D Canvas · warm amber/gold · 7 concentric ring bands
// Each band: inner/outer border, radial sector dividers, glyph per sector
// Magnifier ovals orbit across the stack · flower-of-life center
---

<div id="tr2-wrap" style="position:absolute;inset:0;width:100%;height:100%;overflow:hidden;background:transparent;pointer-events:none;">
  <canvas id="tr2-canvas" style="display:block;width:100%;height:100%;"></canvas>
</div>

<script>
  const wrap   = document.getElementById('tr2-wrap')   as HTMLElement;
  const canvas = document.getElementById('tr2-canvas') as HTMLCanvasElement;
  if (!wrap || !canvas) throw new Error('TR2: missing mount');
  const ctx = canvas.getContext('2d')!;

  /* ── HiDPI ───────────────────────────────────────────────────── */
  function resize() {
    const dpr = Math.min(devicePixelRatio, 2);
    canvas.width  = wrap.clientWidth  * dpr;
    canvas.height = wrap.clientHeight * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  const resizeObs = new ResizeObserver(resize);
  resizeObs.observe(wrap);

  /* ── 8 glyph shapes drawn in local space (sz = radius in px) ── */
  type GFn = (c: CanvasRenderingContext2D, sz: number) => void;

  const GLYPHS: GFn[] = [
    /* 0  {} curly braces */
    (c, sz) => {
      const d = sz * .44, m = sz * .14, b = sz * .11;
      [[-1,1],[1,-1]].forEach(([s]) => {
        c.beginPath();
        c.moveTo(s*m, -d); c.bezierCurveTo(s*d,-d, s*d,-b, s*d,0);
        c.bezierCurveTo(s*d,b, s*(d+b),b, s*(d+b),0);
        c.bezierCurveTo(s*(d+b),-b, s*d,-b, s*d,0);
        c.bezierCurveTo(s*d,b, s*d,d, s*m,d);
        c.stroke();
      });
    },
    /* 1 open spiral */
    (c, sz) => {
      c.beginPath(); c.arc(0,-sz*.08,sz*.43,.25,Math.PI*2.1); c.stroke();
      c.beginPath(); c.arc(sz*.13,sz*.05,sz*.20,0,Math.PI*1.65); c.stroke();
    },
    /* 2 hook + loop */
    (c, sz) => {
      c.beginPath();
      c.moveTo(-sz*.42, sz*.08);
      c.bezierCurveTo(-sz*.35,-sz*.65, sz*.35,-sz*.65, sz*.42,sz*.08);
      c.stroke();
      c.beginPath(); c.arc(sz*.24,sz*.22,sz*.18,0,Math.PI*2); c.stroke();
    },
    /* 3  => fat arrow */
    (c, sz) => {
      c.beginPath();
      c.moveTo(-sz*.48,-sz*.12); c.lineTo(-sz*.12,-sz*.12);
      c.moveTo(-sz*.48, sz*.12); c.lineTo(-sz*.12, sz*.12);
      c.stroke();
      c.beginPath();
      c.moveTo(-sz*.08,-sz*.38); c.lineTo(sz*.46,0); c.lineTo(-sz*.08,sz*.38);
      c.stroke();
    },
    /* 4 vertical + curling tail */
    (c, sz) => {
      c.beginPath();
      c.moveTo(sz*.04,-sz*.52); c.lineTo(sz*.04,sz*.12);
      c.bezierCurveTo(sz*.04,sz*.44, sz*.50,sz*.48, sz*.52,sz*.15);
      c.stroke();
    },
    /* 5  </> JSX tag */
    (c, sz) => {
      c.beginPath();
      c.moveTo(-sz*.18,-sz*.38); c.lineTo(-sz*.46,0); c.lineTo(-sz*.18,sz*.38);
      c.stroke();
      c.beginPath();
      c.moveTo(sz*.18,-sz*.38); c.lineTo(sz*.46,0); c.lineTo(sz*.18,sz*.38);
      c.stroke();
      c.beginPath();
      c.moveTo(sz*.07,-sz*.28); c.lineTo(-sz*.07,sz*.28);
      c.stroke();
    },
    /* 6 concentric open arcs */
    (c, sz) => {
      c.beginPath(); c.arc(0,0,sz*.50,-.15,Math.PI*1.15); c.stroke();
      c.beginPath(); c.arc(0,0,sz*.30,-.38,Math.PI*.92);  c.stroke();
      c.beginPath(); c.arc(0,0,sz*.12,-.60,Math.PI*.70);  c.stroke();
    },
    /* 7  // double slash */
    (c, sz) => {
      c.beginPath();
      c.moveTo(-sz*.24,-sz*.48); c.lineTo(-sz*.02, sz*.48);
      c.moveTo( sz*.02,-sz*.48); c.lineTo( sz*.24, sz*.48);
      c.stroke();
    },
  ];

  /* ── Deform arc — ink roughness + smooth mouse pull ─────────── */
  function deformArc(cx: number, cy: number, r: number, seed: number, rough: number, pullStr: number, mouseA: number) {
    const steps = Math.max(72, Math.ceil(r * 0.7));
    ctx.beginPath();
    for (let i = 0; i <= steps; i++) {
      const a   = (i / steps) * Math.PI * 2;
      const n   = Math.sin(a * 5.1  + seed) * 0.50
                + Math.sin(a * 11.3 + seed * 1.7) * 0.30
                + Math.sin(a * 23.7 + seed * 3.1) * 0.20;
      const ang = ((a - mouseA + Math.PI * 3) % (Math.PI * 2)) - Math.PI;
      const pull = pullStr * Math.max(0, Math.cos(ang)) ** 2;
      const rr  = r + n * rough + pull;
      const x   = cx + Math.cos(a) * rr;
      const y   = cy + Math.sin(a) * rr;
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.closePath();
  }

  /* ── Helpers ────────────────────────────────────────────────── */
  const _rf = (a: number, b: number) => a + Math.random() * (b - a);
  const _ri = (a: number, b: number) => a + Math.floor(Math.random() * (b - a + 1));

  /* ── Mouse state ─────────────────────────────────────────────── */
  let mouseX = wrap.clientWidth  * 0.5;
  let mouseY = wrap.clientHeight * 0.5;
  window.addEventListener('mousemove', (e: MouseEvent) => {
    const r = wrap.getBoundingClientRect();
    mouseX = e.clientX - r.left;
    mouseY = e.clientY - r.top;
  });

  // Smoothly lerped values updated each frame
  let mPullNorm = 0;  // -1 repel … 0 idle … +1 attract
  let colorT    = 0;  // 0 = amber, 1 = lavender

  // Color interpolation
  const AMB: [number,number,number] = [210, 150,  26];
  const LAV: [number,number,number] = [180, 182, 255];
  function iRGB(a: [number,number,number], b: [number,number,number], t: number, alpha: number) {
    return `rgba(${a[0]+(b[0]-a[0])*t|0},${a[1]+(b[1]-a[1])*t|0},${a[2]+(b[2]-a[2])*t|0},${alpha})`;
  }

  // Impact — hot glow + falling particles at cursor hit point
  interface Particle { x:number; y:number; vx:number; vy:number; }
  interface Impact   { x:number; y:number; life:number; particles:Particle[]; }
  const impacts: Impact[] = [];
  function addImpact(x: number, y: number) {
    impacts.push({
      x, y, life: 1,
      particles: Array.from({ length: 7 }, () => {
        const a   = Math.PI * (0.2 + Math.random() * 1.6);
        const spd = 0.6 + Math.random() * 2.8;
        return { x, y, vx: Math.cos(a) * spd, vy: Math.sin(a) * spd - 0.5 };
      }),
    });
  }

  // Spark system — thunder from center to cursor, with branches
  interface Spark { pts: {x:number;y:number}[]; branches: {x:number;y:number}[][]; life: number; }
  const sparks: Spark[] = [];
  let sparkTimer = 0;   // frames until next burst
  let sparkBurst = 0;   // sparks remaining in current burst

  function addSpark(cx: number, cy: number, tx: number, ty: number) {
    const dx = tx - cx, dy = ty - cy;
    const dist = Math.sqrt(dx * dx + dy * dy) || 1;
    const steps = 9 + Math.floor(Math.random() * 5);
    const pts: {x:number;y:number}[] = [{x: cx, y: cy}];
    for (let i = 1; i < steps; i++) {
      const t  = i / steps;
      const jitter = Math.sin(t * Math.PI) * dist * 0.12; // bulge in middle
      pts.push({
        x: cx + dx * t + (Math.random() - 0.5) * jitter,
        y: cy + dy * t + (Math.random() - 0.5) * jitter,
      });
    }
    pts.push({ x: tx, y: ty }); // always reach cursor tip

    // 0–2 side branches off a random trunk segment
    const branches: {x:number;y:number}[][] = [];
    const numBranches = Math.random() > 0.4 ? (Math.random() > 0.6 ? 2 : 1) : 0;
    for (let b = 0; b < numBranches; b++) {
      const bi   = Math.floor(pts.length * (0.25 + Math.random() * 0.5));
      const bp   = pts[bi];
      const bLen = dist * (0.12 + Math.random() * 0.18);
      const bAng = Math.atan2(dy, dx) + (Math.random() < 0.5 ? 1 : -1) * (0.5 + Math.random() * 0.8);
      const bPts: {x:number;y:number}[] = [{ x: bp.x, y: bp.y }];
      const bs   = 3 + Math.floor(Math.random() * 3);
      for (let j = 1; j <= bs; j++) {
        const t = j / bs;
        bPts.push({
          x: bp.x + Math.cos(bAng) * bLen * t + (Math.random() - 0.5) * 7,
          y: bp.y + Math.sin(bAng) * bLen * t + (Math.random() - 0.5) * 7,
        });
      }
      branches.push(bPts);
    }
    sparks.push({ pts, branches, life: 1 });
    if (Math.random() < 0.30) addImpact(tx, ty); // ~1 in 3 strikes triggers impact
  }

  /* ── Belt eye — almond in sector, pupil follows mouse ─────── */
  function drawEye(ex: number, ey: number, eyeW: number, eyeH: number, eyeRot: number, col: string) {
    const ga  = Math.atan2(mouseY - ey, mouseX - ex);
    const la  = ga - eyeRot;
    const off = eyeH * 0.22;
    const px  = Math.cos(la) * off;
    const py  = Math.sin(la) * off;

    ctx.save();
    ctx.translate(ex, ey);
    ctx.rotate(eyeRot);

    ctx.beginPath();
    ctx.moveTo(-eyeW * 0.5, 0);
    ctx.bezierCurveTo(-eyeW * 0.2, -eyeH * 0.5,  eyeW * 0.2, -eyeH * 0.5,  eyeW * 0.5, 0);
    ctx.bezierCurveTo( eyeW * 0.2,  eyeH * 0.5, -eyeW * 0.2,  eyeH * 0.5, -eyeW * 0.5, 0);
    ctx.strokeStyle = col; ctx.lineWidth = 1.4; ctx.stroke();

    const irisR = eyeH * 0.30;
    ctx.beginPath(); ctx.arc(px, py, irisR, 0, Math.PI * 2);
    ctx.strokeStyle = col; ctx.lineWidth = 0.8; ctx.stroke();
    ctx.beginPath(); ctx.arc(px, py, irisR * 0.46, 0, Math.PI * 2);
    ctx.fillStyle = col; ctx.fill();

    ctx.restore();
  }

  /* ── Rings — mixed properties generated randomly at startup ──── */
  // pick exactly 1–2 rings to have a drifting center
  const wobbleIndices = new Set<number>();
  while (wobbleIndices.size < 2) wobbleIndices.add(_ri(1, 5));

  const RINGS = [
    { iF:0.05, oF:0.12, speed:  0.0080 },
    { iF:0.17, oF:0.27, speed: -0.0052 },
    { iF:0.28, oF:0.39, speed:  0.0040 },
    { iF:0.43, oF:0.54, speed: -0.0030 },
    { iF:0.56, oF:0.68, speed:  0.0022 },
    { iF:0.74, oF:0.84, speed: -0.0015 },
    { iF:0.87, oF:0.96, speed:  0.0010 },
    { iF:1.06, oF:1.18, speed: -0.0006, ghost: true },
    { iF:1.26, oF:1.40, speed:  0.0004, ghost: true },
    { iF:1.58, oF:1.78, speed: -0.0003, ghost: true, brightens: true },
  ].map((b: any, i) => {
    const ghost      = b.ghost ?? false;
    const sectors    = ghost ? _ri(5, 8)        : _ri(5, 20);
    const emptyFrac  = ghost ? _rf(0.70, 0.85)  : _rf(0.10, 0.40);
    const emptyCount = Math.floor(sectors * emptyFrac);
    const emptySet   = new Set<number>();
    while (emptySet.size < emptyCount) emptySet.add(_ri(0, sectors - 1));

    const available: number[] = [];
    for (let s = 0; s < sectors; s++) if (!emptySet.has(s)) available.push(s);
    for (let j = available.length - 1; j > 0; j--) {
      const k = _ri(0, j); const tmp = available[j]; available[j] = available[k]; available[k] = tmp;
    }
    const eyeSet = new Set<number>(available.slice(0, Math.min(1, available.length)));

    return {
      ...b, ghost, sectors, emptySet, eyeSet,
      outerBorder: ghost ? false       : Math.random() > 0.42,
      pulses:      ghost ? false       : Math.random() > 0.52,
      pSpeed:      _rf(0.015, 0.055),
      pAmp:        _rf(0.015, 0.042),
      rough:       ghost ? _rf(0.5, 1.0) : _rf(1.2, 2.8),
      seed:        _rf(0, 100),
      wobble:      ghost ? false       : wobbleIndices.has(i),
      wobbleR:     _rf(0.010, 0.022),
      wobbleSpd:   _rf(0.00025, 0.00055),
      wobbleA:     _rf(0, Math.PI * 2),
    };
  });

  const OUTER_GLYPH_COUNT = 3 + Math.floor(Math.random() * 2);
  const angles = new Float32Array(RINGS.length + 1);

  /* ── Grazing circles ─────────────────────────────────────────────
     Each circle's circumference passes through the origin.
     Center orbits at distance = its own radius, so near edge always
     grazes the center while far edge reaches 2r outward into the rings. */
  /* r = base orbit radius, speed = orbit speed, ps = pulse speed, pa = pulse amplitude */
  /* Grazing circles — orbit slowed, size pulses in opposite phases (0 vs π) */
  const GRAZERS = [
    { r: 0.19, speed:  0.008, ps: 0.45, pa: 0.06, phase: 0          }, // ~14s cycle
    { r: 0.25, speed: -0.003, ps: 0.28, pa: 0.07, phase: Math.PI    }, // ~22s cycle
    { r: 0.32, speed:  0.005, ps: 0.45, pa: 0.06, phase: Math.PI    }, // opposite to #1
    { r: 0.39, speed: -0.007, ps: 0.28, pa: 0.09, phase: 0          }, // opposite to #2
  ];
  const grazerA = [0.4, Math.PI * 0.85, Math.PI * 0.2, Math.PI * 1.6];

  /* ── Static palette (petal only — others computed per frame) ── */
  const C_PETAL = 'rgba(212,162,36, 0.48)';

  /* ── Render ───────────────────────────────────────────────────── */
  function draw() {
    const W = wrap.clientWidth, H = wrap.clientHeight;
    const cx = W * .5, cy = H * .5;
    const R  = Math.min(W, H) * .42;

    // Mouse metrics
    const mdx = mouseX - cx, mdy = mouseY - cy;
    const mDist  = Math.sqrt(mdx * mdx + mdy * mdy);
    const mouseA = Math.atan2(mdy, mdx);
    const norm   = mDist / R;
    const targetPull = norm > 1.2 ? 0 : norm < 0.65 ? -(1 - norm / 0.65) : (1 - norm / 1.2);
    mPullNorm += (targetPull - mPullNorm) * 0.055;
    const pullStr  = mPullNorm * R * 0.045;
    const targetCT = Math.max(0, 1 - norm / 3.5);
    colorT += (targetCT - colorT) * 0.04;

    // Dynamic palette
    const C_RING    = iRGB(AMB, LAV, colorT, 0.50);
    const C_RING_HI = iRGB(AMB, LAV, colorT, 0.72);
    const C_GLYPH   = iRGB(AMB, LAV, colorT, 0.86);
    const C_MAG     = iRGB([255,215,65], [200,210,255], colorT, 0.72);

    // Thunder burst — infrequent, cursor must be on canvas (norm < 3)
    sparkTimer = Math.max(0, sparkTimer - 1);
    if (sparkTimer === 0 && norm < 3.0) {
      const proximity = Math.max(0, 1 - norm / 3.0);
      // Squaring one random skews toward short gaps with occasional long silences
      const r1 = Math.random(), r2 = Math.random() * Math.random();
      const base = 30 + proximity * 20 | 0;
      const ceiling = 60 + (1 - proximity) * 360 | 0;
      sparkTimer = base + Math.floor(r2 * ceiling) + (r1 > 0.85 ? Math.floor(Math.random() * 200) : 0);
      sparkBurst = 1 + Math.floor(Math.random() * (proximity > 0.6 ? 4 : 3));
    }
    if (sparkBurst > 0 && Math.random() < 0.35) {
      addSpark(cx, cy, mouseX, mouseY);
      sparkBurst--;
    }

    ctx.clearRect(0, 0, W, H);

    /* Soft ambient glow */
    const grd = ctx.createRadialGradient(cx,cy,R*.06, cx,cy,R*1.05);
    grd.addColorStop(0,   'rgba(175,112,14, 0.16)');
    grd.addColorStop(0.65,'rgba(140,85, 10, 0.06)');
    grd.addColorStop(1,   'rgba(0,0,0,0)');
    ctx.fillStyle = grd;
    ctx.beginPath(); ctx.arc(cx,cy,R*1.05,0,Math.PI*2); ctx.fill();

    /* ── Rings ──────────────────────────────────────────────── */
    for (let ri = 0; ri < RINGS.length; ri++) {
      const rd    = RINGS[ri];
      const rot   = angles[ri];
      const pulse = rd.pulses ? Math.sin(time * rd.pSpeed) * rd.pAmp : 0;
      const iR    = Math.max(2, (rd.iF + pulse) * R);
      const oR    = Math.max(iR + 4, (rd.oF + pulse) * R);
      const mR    = (iR + oR) * .5;
      const bw    = oR - iR;

      if (rd.ghost) ctx.globalAlpha = rd.brightens
        ? 0.05 + Math.max(0, 1 - norm / 1.6) * 0.60   // dim at rest, lights up as cursor nears center
        : 0.16;

      /* Wobbling center — 1-2 rings drift very slowly off-axis */
      const wcx = rd.wobble ? cx + Math.cos(rd.wobbleA) * rd.wobbleR * R : cx;
      const wcy = rd.wobble ? cy + Math.sin(rd.wobbleA) * rd.wobbleR * R : cy;

      /* Outer border — per-ring decision, deformed stroke */
      if (rd.outerBorder) {
        deformArc(wcx, wcy, oR, rd.seed + 10, rd.rough * 0.7, pullStr, mouseA);
        ctx.strokeStyle = C_RING_HI; ctx.lineWidth = 1.3; ctx.stroke();
      }

      /* Inner border — deformed stroke */
      deformArc(wcx, wcy, iR, rd.seed, rd.rough, pullStr, mouseA);
      ctx.strokeStyle = C_RING; ctx.lineWidth = 0.9; ctx.stroke();

      /* Sectors */
      const arcLen = (2*Math.PI*mR) / rd.sectors;
      const sz     = Math.min(bw*.76, arcLen*.56);
      const lw     = Math.max(0.7, Math.min(1.8, sz*.074));

      for (let s = 0; s < rd.sectors; s++) {
        if (rd.emptySet.has(s)) continue;

        const divA = rot + (s / rd.sectors) * Math.PI*2;
        ctx.beginPath();
        ctx.moveTo(wcx + Math.cos(divA)*iR, wcy + Math.sin(divA)*iR);
        ctx.lineTo(wcx + Math.cos(divA)*oR, wcy + Math.sin(divA)*oR);
        ctx.strokeStyle = C_RING; ctx.lineWidth = 0.7; ctx.stroke();

        const midA = rot + ((s + .5) / rd.sectors) * Math.PI*2;
        const ex   = wcx + Math.cos(midA) * mR;
        const ey   = wcy + Math.sin(midA) * mR;

        if (rd.eyeSet.has(s)) {
          drawEye(ex, ey, Math.min(arcLen * 0.75, bw * 1.4), bw * 0.55, midA + Math.PI * 0.5, C_GLYPH);
        } else {
          ctx.save();
          ctx.translate(ex, ey);
          ctx.rotate(midA + Math.PI*.5);
          ctx.strokeStyle = C_GLYPH; ctx.fillStyle = C_GLYPH;
          ctx.lineWidth = lw; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
          GLYPHS[s % 8](ctx, sz);
          ctx.restore();
        }
      }
      if (rd.ghost) ctx.globalAlpha = 1.0;
    }

    /* ── Outer glyph ring — 3-4 bare characters + 1 eye ─────────── */
    {
      const rot = angles[RINGS.length];
      const mR  = R * 1.04;
      const sz  = R * 0.055;
      const lw  = Math.max(0.7, sz * 0.08);
      for (let s = 0; s < OUTER_GLYPH_COUNT; s++) {
        const midA = rot + (s / OUTER_GLYPH_COUNT) * Math.PI * 2;
        const ex   = cx + Math.cos(midA) * mR;
        const ey   = cy + Math.sin(midA) * mR;
        if (s === 0) {
          drawEye(ex, ey, sz * 1.8, sz * 0.9, midA + Math.PI * 0.5, C_GLYPH);
        } else {
          ctx.save();
          ctx.translate(ex, ey);
          ctx.rotate(midA + Math.PI*.5);
          ctx.strokeStyle = C_GLYPH; ctx.fillStyle = C_GLYPH;
          ctx.lineWidth = lw; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
          GLYPHS[(s + 3) % 8](ctx, sz);
          ctx.restore();
        }
      }
    }

    /* ── Grazing circles — radius pulses independently per circle ── */
    for (let gi = 0; gi < GRAZERS.length; gi++) {
      const g  = GRAZERS[gi];
      const a  = grazerA[gi];
      const pr = (g.r + Math.sin(time * g.ps + g.phase) * g.pa) * R;
      ctx.beginPath();
      ctx.arc(cx + Math.cos(a)*pr, cy + Math.sin(a)*pr, pr, 0, Math.PI*2);
      ctx.strokeStyle = C_MAG;
      ctx.lineWidth   = 1.4;
      ctx.stroke();
    }

    /* ── Sparks ─────────────────────────────────────────────────── */
    for (let i = sparks.length - 1; i >= 0; i--) {
      const sp = sparks[i];
      sp.life -= 0.07;
      if (sp.life <= 0) { sparks.splice(i, 1); continue; }
      const sr = (180 + colorT * 75) | 0, sg = (210 + colorT * 45) | 0;
      ctx.lineCap = 'round';
      // Main trunk
      ctx.beginPath();
      ctx.moveTo(sp.pts[0].x, sp.pts[0].y);
      for (let j = 1; j < sp.pts.length; j++) ctx.lineTo(sp.pts[j].x, sp.pts[j].y);
      ctx.strokeStyle = `rgba(${sr},${sg},255,${sp.life * 0.88})`;
      ctx.lineWidth   = 1.2 + sp.life;
      ctx.stroke();
      // Branches — thinner, dimmer
      for (const bPts of sp.branches) {
        ctx.beginPath();
        ctx.moveTo(bPts[0].x, bPts[0].y);
        for (let j = 1; j < bPts.length; j++) ctx.lineTo(bPts[j].x, bPts[j].y);
        ctx.strokeStyle = `rgba(${sr},${sg},255,${sp.life * 0.45})`;
        ctx.lineWidth   = 0.6 + sp.life * 0.3;
        ctx.stroke();
      }
    }

    /* ── Impact glow + falling sparks at cursor hit ─────────── */
    for (let i = impacts.length - 1; i >= 0; i--) {
      const imp = impacts[i];
      imp.life -= 0.055;
      if (imp.life <= 0) { impacts.splice(i, 1); continue; }

      // Hot radial glow
      const glowR = 6 + (1 - imp.life) * 10;
      const glow  = ctx.createRadialGradient(imp.x, imp.y, 0, imp.x, imp.y, glowR);
      glow.addColorStop(0,   `rgba(255,220,100,${imp.life * 0.95})`);
      glow.addColorStop(0.4, `rgba(255,80,20,${imp.life * 0.60})`);
      glow.addColorStop(1,   'rgba(180,0,0,0)');
      ctx.fillStyle = glow;
      ctx.beginPath(); ctx.arc(imp.x, imp.y, glowR, 0, Math.PI * 2); ctx.fill();

      // Falling particles with gravity
      for (const p of imp.particles) {
        p.vy += 0.14;
        p.vx *= 0.95;
        p.x  += p.vx;
        p.y  += p.vy;
        ctx.beginPath(); ctx.arc(p.x, p.y, 1.3, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,${100 + Math.random() * 120 | 0},20,${imp.life * 0.85})`;
        ctx.fill();
      }
    }

    /* ── Central flower-of-life ──────────────────────────────── */
    const pR = R * .040;
    ctx.strokeStyle = C_PETAL; ctx.lineWidth = 0.9;
    for (let i = 0; i < 6; i++) {
      const a = (i/6) * Math.PI*2;
      ctx.beginPath();
      ctx.arc(cx + Math.cos(a)*pR, cy + Math.sin(a)*pR, pR, 0, Math.PI*2);
      ctx.stroke();
    }
    ctx.beginPath(); ctx.arc(cx,cy,pR*2,0,Math.PI*2);
    ctx.strokeStyle = 'rgba(200,150,32,0.42)'; ctx.stroke();

    /* Center glow dot */
    const dg = ctx.createRadialGradient(cx,cy,0, cx,cy,pR*.65);
    dg.addColorStop(0, 'rgba(255,235,100,0.95)');
    dg.addColorStop(1, 'rgba(255,215,70,0)');
    ctx.fillStyle = dg;
    ctx.beginPath(); ctx.arc(cx,cy,pR*.65,0,Math.PI*2); ctx.fill();
  }

  /* ── Animation loop ──────────────────────────────────────────── */
  let raf = 0, time = 0;
  function frame() {
    raf = requestAnimationFrame(frame);
    time += 0.016;
    for (let i = 0; i < RINGS.length; i++) {
      angles[i] += RINGS[i].speed;
      if (RINGS[i].wobble) RINGS[i].wobbleA += RINGS[i].wobbleSpd;
    }
    angles[RINGS.length] += 0.0018;
    for (let i = 0; i < GRAZERS.length; i++) grazerA[i] += GRAZERS[i].speed;
    draw();
  }
  frame();

  /* ── Cleanup ─────────────────────────────────────────────────── */
  document.addEventListener('astro:before-preparation', () => {
    cancelAnimationFrame(raf);
    resizeObs.disconnect();
  }, { once: true });
</script>
