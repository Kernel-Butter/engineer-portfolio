---
const roles = [
  {
    period: 'JAN 2026 — PRESENT',
    location: 'Dubai, UAE (Remote)',
    title: 'Frontend Software Engineer',
    company: 'THE WHITE BOUTIQUE',
    icon: 'shopping_cart',
    reverse: false,
    bullets: [
      'Built the end-to-end checkout journey in Next.js and TypeScript — cart state (Zustand), order creation, address/map selection, and real-time Supabase inventory sync — reaching a 95%+ checkout completion rate.',
      'Integrated four payment gateways (Stripe, Noon Payments, Apple Pay, Google Pay) behind a unified layer with consistent error handling and transaction logging.',
      'Shipped SEO-optimized product pages using SSR and ISR, serving 50,000+ monthly product pages.',
    ],
    chips: [
      { label: 'Next.js',     accent: true  },
      { label: 'TypeScript',  accent: false },
      { label: 'Supabase',    accent: false },
    ],
  },
  {
    period: 'JUL 2024 — DEC 2025',
    location: 'Remote — US & Intl. clients',
    title: 'Frontend Developer',
    company: 'TOPDOT (US: DOTLOGICS)',
    icon: 'sports_esports',
    reverse: true,
    bullets: [
      'Developed interactive web-based games with Vanilla JavaScript, Canvas API, and GSAP, alongside pixel-perfect responsive sites for architecture firms, restaurant chains, and SaaS platforms.',
      'Built animation-intensive UIs with GSAP scroll animations, parallax effects, and smooth page transitions.',
      'Maintained 90%+ Google Lighthouse scores through Web Vitals monitoring — cut delivery time by roughly 30% by adopting AI-assisted development workflows while keeping code-review standards.',
    ],
    chips: [
      { label: 'JavaScript', accent: false },
      { label: 'Canvas API', accent: false },
      { label: 'GSAP',       accent: false },
    ],
  },
  {
    period: 'APR 2023 — DEC 2023',
    location: 'Lahore, Pakistan',
    title: 'Associate Software Engineer',
    company: 'ABSOLUIT',
    icon: 'hub',
    reverse: false,
    bullets: [
      'Built a reusable React component library adopted across team projects, shortening development cycles.',
      'Worked in agile sprints with Git-based code reviews and Jira, integrating REST and GraphQL APIs.',
    ],
    chips: [
      { label: 'React', accent: false },
      { label: 'REST',  accent: false },
      { label: 'GraphQL', accent: false },
    ],
  },
];
---

<section id="experience" class="py-section-padding px-margin-mobile md:px-margin-desktop">
  <div class="w-full max-w-container-max mx-auto">

    <!-- Header -->
    <div class="exp-header mb-24 text-center md:text-left">
      <div class="flex items-center gap-3 mb-4 justify-center md:justify-start">
        <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
        <span data-cms="career.sectionLabel" class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">// CHRONOLOGICAL_RECORD</span>
      </div>
      <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-4">
        <span class="text-secondary opacity-50 font-code-snippet text-code-snippet mr-2">07 //</span><span data-cms="career.sectionTitle">EXPERIENCE</span>
      </h2>
      <p data-cms="career.sectionSubtitle" class="font-body-md text-body-md text-on-surface-variant max-w-2xl">
        A chronological record of frontend engineering roles across e-commerce, agency, and product work.
      </p>
    </div>

    <!-- Timeline -->
    <div class="timeline-container relative w-full pb-12">

      <!-- SVG vertical line -->
      <svg class="timeline-line-svg" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" viewBox="0 0 4 1000">
        <line x1="2" x2="2" y1="0" y2="1000" stroke="#353534" stroke-width="2" />
        <line id="career-line" x1="2" x2="2" y1="0" y2="1000" stroke="#c0c1ff" stroke-width="2"
              stroke-dasharray="1000" stroke-dashoffset="1000" />
      </svg>

      {roles.map((role, i) => (
        <div class={`exp-entry relative w-full flex flex-col items-center mb-16 last:mb-0 ${role.reverse ? 'md:flex-row-reverse' : 'md:flex-row'} justify-between group`}>

          <!-- Timeline node -->
          <div class="timeline-node"></div>

          <!-- Date / location -->
          <div class={`w-full md:w-[45%] pl-12 md:pl-0 mb-4 md:mb-0 ${role.reverse ? 'md:pl-8 text-left' : 'md:pr-8 md:text-right'}`}>
            <div data-cms={`career.roles.${i}.period`} class="font-code-snippet text-code-snippet text-secondary mb-1">{role.period}</div>
            <div data-cms={`career.roles.${i}.location`} class="font-label-sm text-label-sm text-outline uppercase tracking-widest">{role.location}</div>
          </div>

          <!-- Card -->
          <div class={`w-full md:w-[45%] pl-12 ${role.reverse ? 'md:pl-0 md:pr-8' : 'md:pl-8'}`}>
            <div class="glass-card rounded-lg p-6">

              <div class="flex items-start justify-between mb-4">
                <div>
                  <h3 data-cms={`career.roles.${i}.title`} class="font-headline-md text-headline-md text-primary mb-1">{role.title}</h3>
                  <div data-cms={`career.roles.${i}.company`} class="font-code-snippet text-code-snippet text-on-surface-variant">{role.company}</div>
                </div>
                <span class="material-symbols-outlined text-secondary opacity-50">{role.icon}</span>
              </div>

              <ul data-cms-bullets={`career.roles.${i}.bullets`} class="space-y-3 font-body-md text-body-md text-on-surface">
                {role.bullets.map(b => (
                  <li class="flex items-start">
                    <span class="text-secondary font-code-snippet mt-1 shrink-0 mr-2">&gt;</span>
                    {b}
                  </li>
                ))}
              </ul>

              <div data-cms-chips={`career.roles.${i}.chips`} class="mt-6 flex flex-wrap gap-2">
                {role.chips.map(c => (
                  <span class={`px-3 py-1 rounded font-label-sm text-label-sm bg-[#171717] ${c.accent ? 'text-tertiary border border-tertiary/30' : 'text-on-surface-variant border border-white/10'}`}>
                    {c.label}
                  </span>
                ))}
              </div>

            </div>
          </div>

        </div>
      ))}

    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { fadeUp, drawSvgLine } from '../scripts/animations.js';

  fadeUp('#experience .exp-header', '#experience');
  drawSvgLine('career-line', '.timeline-container');

  // Sync card reveal with the scrubbed timeline line.
  // drawSvgLine scrubs over .timeline-container from 'top 70%' to 'bottom 60%'.
  // Each node's center passes ~68% viewport at the moment the line reaches it,
  // so triggering on the node at 'center 68%' keeps the page-turn in sync with the dot fill.
  document.querySelectorAll('#experience .exp-entry').forEach(entry => {
    const card = entry.querySelector('.glass-card');
    const node = entry.querySelector('.timeline-node');
    const meta = entry.querySelector('.timeline-node ~ div'); // date/location — opposite side to card
    const isRight = !entry.classList.contains('md:flex-row-reverse');

    // Date/location slides out from the line toward its side (opposite direction to card)
    gsap.fromTo(meta,
      { opacity: 0, x: isRight ? 30 : -30 },
      { opacity: 1, x: 0, duration: 1.4, ease: 'power1.out',
        scrollTrigger: { trigger: node, start: 'center 68%', toggleActions: 'play none none reverse' } }
    );

    // Fill the dot when the line reaches it
    gsap.fromTo(node,
      { backgroundColor: '#131313', boxShadow: '0 0 0px rgba(192,193,255,0)' },
      { backgroundColor: '#c0c1ff', boxShadow: '0 0 14px rgba(192,193,255,0.7)',
        duration: 0.4, ease: 'power2.out',
        scrollTrigger: { trigger: node, start: 'center 68%', toggleActions: 'play none none reverse' } }
    );

    gsap.fromTo(card,
      {
        rotateY: isRight ? -90 : 90,
        transformOrigin: isRight ? 'left center' : 'right center',
        transformPerspective: 1200,
        opacity: 0,
      },
      {
        rotateY: 0,
        opacity: 1,
        duration: 0.9,
        ease: 'power2.out',
        scrollTrigger: { trigger: node, start: 'center 68%', toggleActions: 'play none none reverse' },
      }
    );
  });
</script>
