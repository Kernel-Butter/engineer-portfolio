---
// LatticeSphere — PBD cloth physics sphere
// Position-Based Dynamics: Verlet integration, spring constraints
// Back-cap cut (20%), free boundary → wave reflection chaos, inward click dent
---

<div id="ls-wrap" style="position:relative;width:100%;height:calc(100vh - 56px);overflow:hidden;background:#03030a;">
  <canvas id="ls-canvas" style="display:block;width:100%;height:100%;"></canvas>
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass }     from 'three/addons/postprocessing/RenderPass.js';
  import { mergeVertices }  from 'three/addons/utils/BufferGeometryUtils.js';

  // astro:page-load (not top-level) — Astro's client-side nav only executes
  // this module once ever, but the canvas element is recreated fresh on
  // every visit to this page. Without re-binding here, returning to this
  // page a second time leaves a blank canvas.
  document.addEventListener('astro:page-load', () => {
  const wrap   = document.getElementById('ls-wrap')   as HTMLElement;
  const canvas = document.getElementById('ls-canvas') as HTMLCanvasElement;
  if (!wrap || !canvas) throw new Error('LS: missing mount');

  /* ── Renderer ─────────────────────────────────────────────────── */
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setSize(wrap.clientWidth, wrap.clientHeight);
  renderer.toneMapping         = THREE.ReinhardToneMapping;
  renderer.toneMappingExposure = 1.5;

  const scene  = new THREE.Scene();
  scene.background = new THREE.Color(0x03030a);

  const camera = new THREE.PerspectiveCamera(58, wrap.clientWidth / wrap.clientHeight, 0.05, 200);
  camera.position.set(0, 0, 6.5);

  /* ══════════════════════════════════════════════════════════════
     CLOTH PHYSICS — Position-Based Dynamics
     ══════════════════════════════════════════════════════════════ */

  const DETAIL   = 3;     // icosahedron subdivision → ~642 verts, 1280 triangles
  const RADIUS   = 2.0;
  const CLIP_Z   = -0.3;  // show front ~65 % of sphere; back cap hidden
  const STIFF    = 0.30;
  const DAMP     = 0.993;
  const PRESSURE = 0.0008;
  const ITER     = 8;
  const DT       = 0.22;

  /* Physics geometry — compact indexed icosphere; all spring constraints run here.
     IcosahedronGeometry (like all PolyhedronGeometry) ships non-indexed —
     mergeVertices welds the duplicate corner vertices into a proper shared-
     vertex index, which the spring/neighbour system below depends on. */
  const geo     = mergeVertices(new THREE.IcosahedronGeometry(RADIUS, DETAIL));
  const posAttr = geo.attributes.position as THREE.BufferAttribute;
  const N       = posAttr.count;
  const physIdx = (geo.index as THREE.BufferAttribute).array;

  /* Render geometry — non-indexed copy so each triangle corner gets a unique
     vertex and we can stamp barycentric coords (1,0,0)/(0,1,0)/(0,0,1). */
  const renderGeo    = geo.toNonIndexed();
  const renderPosArr = renderGeo.attributes.position as THREE.BufferAttribute;
  const M            = renderPosArr.count;

  const baryArr = new Float32Array(M * 3);
  for (let f = 0; f < M; f += 3) {
    baryArr[(f+0)*3+0] = 1;
    baryArr[(f+1)*3+1] = 1;
    baryArr[(f+2)*3+2] = 1;
  }
  renderGeo.setAttribute('bary', new THREE.BufferAttribute(baryArr, 3));


  /* Explicit velocity array — key to proper slow-motion.
     Velocity persists frame-to-frame (only DAMP removes it),
     so wave energy doesn't vanish in 3 frames like it did with Verlet + SPEED_SCALE. */
  const pos    = new Float32Array(posAttr.array); /* current positions  */
  const vel    = new Float32Array(N * 3);          /* explicit velocities (start at 0) */
  const rest   = new Float32Array(posAttr.array); /* rest shape (constant)            */
  const posOld = new Float32Array(N * 3);          /* positions at frame start (for vel update) */

  /* ── Springs: ALL vertices participate — no frozen boundary ──────
     Back-cap vertices are invisible (discarded by shader) but still
     simulated. The cut edge therefore has all its springs intact and
     waves flow freely across the boundary instead of getting stuck. */
  interface Spring { a: number; b: number; len: number; }
  const springs: Spring[] = [];
  const edgeSet = new Set<number>();

  function addSpring(a: number, b: number) {
    const key = Math.min(a, b) * 100000 + Math.max(a, b);
    if (edgeSet.has(key)) return;
    edgeSet.add(key);
    const dx = pos[a*3]   - pos[b*3];
    const dy = pos[a*3+1] - pos[b*3+1];
    const dz = pos[a*3+2] - pos[b*3+2];
    springs.push({ a, b, len: Math.sqrt(dx*dx + dy*dy + dz*dz) });
  }

  for (let i = 0; i < physIdx.length; i += 3) {
    addSpring(physIdx[i], physIdx[i+1]);
    addSpring(physIdx[i+1], physIdx[i+2]);
    addSpring(physIdx[i], physIdx[i+2]);
  }

  /* ── PBD step (explicit velocity + DT slow-motion) ──────────────
     Unlike Verlet where velocity = cur−prev (causing v × DT^n decay),
     here velocity lives in its own array and only loses DAMP per frame.
     Wave energy therefore persists and travels; DT just slows position steps. */
  function clothStep() {
    /* 1 — Save positions, apply forces, integrate */
    for (let i = 0; i < N; i++) {
      posOld[i*3]   = pos[i*3];
      posOld[i*3+1] = pos[i*3+1];
      posOld[i*3+2] = pos[i*3+2];

      /* Pressure: gentle pull toward rest shape */
      vel[i*3]   += (rest[i*3]   - pos[i*3])   * PRESSURE;
      vel[i*3+1] += (rest[i*3+1] - pos[i*3+1]) * PRESSURE;
      vel[i*3+2] += (rest[i*3+2] - pos[i*3+2]) * PRESSURE;

      /* Damping applied directly to velocity (linear, not exponential) */
      vel[i*3]   *= DAMP;
      vel[i*3+1] *= DAMP;
      vel[i*3+2] *= DAMP;

      /* Integrate: DT controls wave speed (slow-motion knob) */
      pos[i*3]   += vel[i*3]   * DT;
      pos[i*3+1] += vel[i*3+1] * DT;
      pos[i*3+2] += vel[i*3+2] * DT;
    }

    /* 2 — Satisfy spring constraints (position projection) */
    for (let iter = 0; iter < ITER; iter++) {
      for (const { a, b, len } of springs) {
        const ax = pos[a*3], ay = pos[a*3+1], az = pos[a*3+2];
        const bx = pos[b*3], by = pos[b*3+1], bz = pos[b*3+2];
        const dx = bx - ax, dy = by - ay, dz = bz - az;
        const d  = Math.sqrt(dx*dx + dy*dy + dz*dz);
        if (d < 1e-6) continue;
        const c = (d - len) / d * 0.5 * STIFF;
        pos[a*3]   += dx*c;  pos[a*3+1] += dy*c;  pos[a*3+2] += dz*c;
        pos[b*3]   -= dx*c;  pos[b*3+1] -= dy*c;  pos[b*3+2] -= dz*c;
      }
    }

    /* 3 — Derive velocity from constrained positions (standard PBD update).
       Spring corrections are baked into the new velocity → wave energy
       transfers to neighbours and propagates across the surface. */
    for (let i = 0; i < N; i++) {
      vel[i*3]   = (pos[i*3]   - posOld[i*3])   / DT;
      vel[i*3+1] = (pos[i*3+1] - posOld[i*3+1]) / DT;
      vel[i*3+2] = (pos[i*3+2] - posOld[i*3+2]) / DT;
    }

    /* Sync indexed physics positions → non-indexed render geometry */
    const rArr = renderPosArr.array as Float32Array;
    for (let j = 0; j < M; j++) {
      const k   = physIdx[j];
      rArr[j*3]   = pos[k*3];
      rArr[j*3+1] = pos[k*3+1];
      rArr[j*3+2] = pos[k*3+2];
    }
    renderPosArr.needsUpdate = true;
    renderGeo.computeVertexNormals();
  }

  /* ── Click impulse — big INWARD dent ─────────────────────────── */
  const hitSphere = new THREE.Mesh(
    new THREE.SphereGeometry(RADIUS, 32, 32),
    new THREE.MeshBasicMaterial({ visible: false })
  );
  scene.add(hitSphere);

  const raycaster = new THREE.Raycaster();
  const _m = new THREE.Vector2();

  wrap.addEventListener('click', (e: MouseEvent) => {
    const rect = wrap.getBoundingClientRect();
    _m.x =  ((e.clientX - rect.left) / rect.width)  * 2 - 1;
    _m.y = -((e.clientY - rect.top)  / rect.height) * 2 + 1;
    raycaster.setFromCamera(_m, camera);
    const hits = raycaster.intersectObject(hitSphere);
    if (!hits.length) return;

    const hp = hits[0].point;
    const IMPULSE_R   = 1.2;  /* small crater */
    const IMPULSE_STR = 0.55; /* gentle tap */

    for (let i = 0; i < N; i++) {
      const dx   = pos[i*3]   - hp.x;
      const dy   = pos[i*3+1] - hp.y;
      const dz   = pos[i*3+2] - hp.z;
      const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
      if (dist > IMPULSE_R) continue;

      const t   = 1 - dist / IMPULSE_R;
      const str = t * t * IMPULSE_STR;

      /* Inward unit normal */
      const nx = pos[i*3]   / RADIUS;
      const ny = pos[i*3+1] / RADIUS;
      const nz = pos[i*3+2] / RADIUS;

      /* Apply inward velocity impulse directly to explicit vel array */
      vel[i*3]   -= nx * str;
      vel[i*3+1] -= ny * str;
      vel[i*3+2] -= nz * str;
    }
  });

  /* ══════════════════════════════════════════════════════════════
     RENDERING — geodesic triangular lattice
     Barycentric coords detect triangle edges; restPos attribute
     keeps the hemisphere clip fixed while the mesh deforms.
     ══════════════════════════════════════════════════════════════ */

  /* Vertex shader — passes bary coord and local-space z for hemisphere clip.
     Using position.z (built-in Three.js attribute) avoids a custom restPos
     attribute that may not bind on all drivers. Clip boundary shifts slightly
     with physics deformation but is imperceptible at the equator. */
  const VS = /* glsl */`
    attribute vec3 bary;
    varying   vec3 vBary;
    varying   float vZ;
    void main(){
      vBary = bary;
      vZ    = position.z;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `;

  /* Show front ~65 % of the sphere; back cap is invisible. */
  const CLIP_GLSL = /* glsl */`
    if (vZ < ${CLIP_Z.toFixed(1)}) discard;
  `;

  /* min(bary.x, bary.y, bary.z) == 0 on every triangle edge, ~0.33 at centroid.
     Strut width = STRUT in barycentric space (~10 % of triangle per edge). */
  const STRUT = 0.10;
  const LATTICE = /* glsl */`
    float edge  = min(vBary.x, min(vBary.y, vBary.z));
    float aa    = max(fwidth(edge), 0.002);
    float strut = 1.0 - smoothstep(${STRUT} - aa, ${STRUT} + aa, edge);
    if (strut < 0.02) discard;
  `;

  const FS_OUTER = /* glsl */`
    varying vec3  vBary;
    varying float vZ;
    void main(){
      ${CLIP_GLSL}
      ${LATTICE}
      vec3 dark   = vec3(0.04, 0.03, 0.10);
      vec3 bright = vec3(0.45, 0.45, 0.80);
      gl_FragColor = vec4(mix(dark, bright, pow(strut, 1.4)), strut);
    }
  `;

  const FS_INNER = /* glsl */`
    varying vec3  vBary;
    varying float vZ;
    void main(){
      ${CLIP_GLSL}
      ${LATTICE}
      vec3 dark   = vec3(0.50, 0.55, 0.60);
      vec3 bright = vec3(0.90, 0.93, 1.00);
      gl_FragColor = vec4(mix(dark, bright, pow(strut, 1.2)), strut);
    }
  `;

  const innerMat = new THREE.ShaderMaterial({
    vertexShader: VS, fragmentShader: FS_INNER,
    transparent: true, side: THREE.BackSide, depthWrite: true,
    polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1,
  });
  const innerMesh = new THREE.Mesh(renderGeo, innerMat);
  innerMesh.renderOrder = 0;
  scene.add(innerMesh);

  const outerMat = new THREE.ShaderMaterial({
    vertexShader: VS, fragmentShader: FS_OUTER,
    transparent: true, side: THREE.FrontSide, depthWrite: true,
  });
  const outerMesh = new THREE.Mesh(renderGeo, outerMat);
  outerMesh.renderOrder = 1;
  scene.add(outerMesh);

  /* ── Post / resize / loop ─────────────────────────────────────── */
  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));

  function onResize() {
    const w = wrap.clientWidth, h = wrap.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
    composer.setSize(w, h);
  }
  const resizeObs = new ResizeObserver(onResize);
  resizeObs.observe(wrap);

  let raf = 0;
  function frame() {
    raf = requestAnimationFrame(frame);
    clothStep();
    camera.lookAt(0, 0, 0);
    composer.render();
  }
  frame();

  document.addEventListener('astro:before-preparation', () => {
    cancelAnimationFrame(raf);
    resizeObs.disconnect();
    composer.dispose();
    renderer.dispose();
    geo.dispose();
    renderGeo.dispose();
    innerMat.dispose();
    outerMat.dispose();
    (hitSphere.material as THREE.Material).dispose();
    hitSphere.geometry.dispose();
  }, { once: true });
  });
</script>
