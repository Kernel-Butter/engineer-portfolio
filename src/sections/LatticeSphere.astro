---
// LatticeSphere — geodesic lattice sphere, two-mesh approach for clean front/back separation
---

<div id="ls-wrap" style="position:relative;width:100%;height:calc(100vh - 56px);overflow:hidden;background:#03030a;">
  <canvas id="ls-canvas" style="display:block;width:100%;height:100%;"></canvas>
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass }     from 'three/addons/postprocessing/RenderPass.js';

  const wrap   = document.getElementById('ls-wrap')   as HTMLElement;
  const canvas = document.getElementById('ls-canvas') as HTMLCanvasElement;
  if (!wrap || !canvas) throw new Error('LatticeSphere: mount point missing');

  /* ── Renderer ────────────────────────────────────────────────── */
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(wrap.clientWidth, wrap.clientHeight);
  renderer.toneMapping         = THREE.ReinhardToneMapping;
  renderer.toneMappingExposure = 1.5;

  /* ── Scene / Camera ──────────────────────────────────────────── */
  const scene  = new THREE.Scene();
  scene.background = new THREE.Color(0x03030a);

  const camera = new THREE.PerspectiveCamera(58, wrap.clientWidth / wrap.clientHeight, 0.05, 200);
  camera.position.set(0, 0.5, 5.5);

  /* ── Shared vertex shader (displacement + barycentric pass-through) ── */
  const VS = /* glsl */`
    attribute vec3 aBary;
    varying   vec3 vBary;
    uniform float  uTime;

    vec3 hash3(vec3 p) {
      p = vec3(dot(p,vec3(127.1,311.7, 74.7)),
               dot(p,vec3(269.5,183.3,246.1)),
               dot(p,vec3(113.5,271.9,124.6)));
      return -1.0 + 2.0*fract(sin(p)*43758.5453123);
    }
    float gnoise(vec3 p){
      vec3 i=floor(p), f=fract(p), u=f*f*(3.0-2.0*f);
      return mix(
        mix(mix(dot(hash3(i            ),f            ),
                dot(hash3(i+vec3(1,0,0)),f-vec3(1,0,0)),u.x),
            mix(dot(hash3(i+vec3(0,1,0)),f-vec3(0,1,0)),
                dot(hash3(i+vec3(1,1,0)),f-vec3(1,1,0)),u.x),u.y),
        mix(mix(dot(hash3(i+vec3(0,0,1)),f-vec3(0,0,1)),
                dot(hash3(i+vec3(1,0,1)),f-vec3(1,0,1)),u.x),
            mix(dot(hash3(i+vec3(0,1,1)),f-vec3(0,1,1)),
                dot(hash3(i+vec3(1,1,1)),f-vec3(1,1,1)),u.x),u.y),u.z);
    }
    float fbm(vec3 p){
      float v=0.0,a=0.5;
      for(int i=0;i<4;i++){v+=a*gnoise(p);p=p*2.1+vec3(31.4,17.9,27.3);a*=0.5;}
      return v;
    }

    void main(){
      vBary = aBary;
      vec3 pos  = position;
      float d1  = fbm(pos*0.75 + vec3(uTime*0.10, uTime*0.07, uTime*0.09));
      float d2  = fbm(pos*1.50 - vec3(uTime*0.06, uTime*0.11, uTime*0.08));
      pos += normal * (d1*0.55 + d2*0.28) * 0.52;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
    }
  `;

  /* ── Shared strut logic as a GLSL snippet ────────────────────── */
  const STRUT_GLSL = /* glsl */`
    float mb = min(min(vBary.x, vBary.y), vBary.z);
    float strutWidth = 0.20;
    float aa   = max(fwidth(mb), 0.001);
    float hole = smoothstep(strutWidth - aa, strutWidth + aa, mb);
    if (hole > 0.98) discard;
    float strut = 1.0 - hole;
  `;

  /* ── Outer fragment shader — dark brand palette ──────────────── */
  const FS_OUTER = /* glsl */`
    varying vec3 vBary;
    void main(){
      ${STRUT_GLSL}
      /* Deep navy → muted lavender matching #c0c1ff brand */
      vec3 dark   = vec3(0.04, 0.03, 0.10);
      vec3 bright = vec3(0.38, 0.38, 0.72);
      vec3 col    = mix(dark, bright, pow(strut, 1.4));
      gl_FragColor = vec4(col, strut);
    }
  `;

  /* ── Inner fragment shader — bright near-white ───────────────── */
  const FS_INNER = /* glsl */`
    varying vec3 vBary;
    void main(){
      ${STRUT_GLSL}
      /* Mid-grey → near white — feels lit from within */
      vec3 dark   = vec3(0.50, 0.55, 0.60);
      vec3 bright = vec3(0.90, 0.93, 1.00);
      vec3 col    = mix(dark, bright, pow(strut, 1.2));
      gl_FragColor = vec4(col, strut);
    }
  `;

  /* ── Geometry (shared between both meshes) ───────────────────── */
  const geo = new THREE.IcosahedronGeometry(2.0, 5).toNonIndexed();
  geo.computeVertexNormals();

  const count   = geo.attributes.position.count;
  const baryArr = new Float32Array(count * 3);
  for (let i = 0; i < count; i += 3) {
    baryArr[i*3  ] = 1; baryArr[i*3+1] = 0; baryArr[i*3+2] = 0;
    baryArr[(i+1)*3  ] = 0; baryArr[(i+1)*3+1] = 1; baryArr[(i+1)*3+2] = 0;
    baryArr[(i+2)*3  ] = 0; baryArr[(i+2)*3+1] = 0; baryArr[(i+2)*3+2] = 1;
  }
  geo.setAttribute('aBary', new THREE.BufferAttribute(baryArr, 3));

  /* ── Shared uniforms (both meshes tick the same time) ────────── */
  const uniforms = { uTime: { value: 0 } };

  /* ── Inner mesh — BackSide, renders first, depthWrite on ─────── */
  const innerMat = new THREE.ShaderMaterial({
    vertexShader: VS, fragmentShader: FS_INNER,
    uniforms,
    transparent:         true,
    side:                THREE.BackSide,
    depthWrite:          true,
    polygonOffset:       true,   /* push inner slightly behind outer → no z-fight */
    polygonOffsetFactor: 1,
    polygonOffsetUnits:  1,
  });
  const innerMesh = new THREE.Mesh(geo, innerMat);
  innerMesh.renderOrder = 0;
  scene.add(innerMesh);

  /* ── Outer mesh — FrontSide, renders second, depthWrite on ──── */
  const outerMat = new THREE.ShaderMaterial({
    vertexShader: VS, fragmentShader: FS_OUTER,
    uniforms,
    transparent: true,
    side:        THREE.FrontSide,
    depthWrite:  true,
  });
  const outerMesh = new THREE.Mesh(geo, outerMat);
  outerMesh.renderOrder = 1;
  scene.add(outerMesh);

  /* ── Post-processing ─────────────────────────────────────────── */
  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));

  /* ── Resize ──────────────────────────────────────────────────── */
  function onResize() {
    const w = wrap.clientWidth, h = wrap.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
    composer.setSize(w, h);
  }
  const resizeObs = new ResizeObserver(onResize);
  resizeObs.observe(wrap);

  /* ── Animate ─────────────────────────────────────────────────── */
  let raf = 0;
  let t   = 0;

  function frame() {
    raf = requestAnimationFrame(frame);
    t += 0.004;

    uniforms.uTime.value = t;

    const orbitR = 5.8;
    camera.position.x = Math.sin(t * 0.22) * orbitR;
    camera.position.z = Math.cos(t * 0.22) * orbitR;
    camera.position.y = Math.sin(t * 0.11) * 2.8;
    camera.lookAt(0, 0, 0);

    composer.render();
  }
  frame();

  /* ── Cleanup ─────────────────────────────────────────────────── */
  document.addEventListener('astro:before-preparation', () => {
    cancelAnimationFrame(raf);
    resizeObs.disconnect();
    composer.dispose();
    renderer.dispose();
    geo.dispose();
    innerMat.dispose();
    outerMat.dispose();
  }, { once: true });
</script>
