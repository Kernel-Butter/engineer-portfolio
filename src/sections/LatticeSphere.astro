---
// LatticeSphere — PBD cloth physics sphere
// Position-Based Dynamics (industry standard: Nvidia PhysX, Unity, Unreal)
// Structural + shear + bending springs, Verlet integration, wind + click impulse
---

<div id="ls-wrap" style="position:relative;width:100%;height:calc(100vh - 56px);overflow:hidden;background:#03030a;">
  <canvas id="ls-canvas" style="display:block;width:100%;height:100%;"></canvas>
</div>

<script>
  import * as THREE from 'three';
  import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';
  import { RenderPass }     from 'three/addons/postprocessing/RenderPass.js';

  const wrap   = document.getElementById('ls-wrap')   as HTMLElement;
  const canvas = document.getElementById('ls-canvas') as HTMLCanvasElement;
  if (!wrap || !canvas) throw new Error('LS: missing mount');

  /* ── Renderer ─────────────────────────────────────────────────── */
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setSize(wrap.clientWidth, wrap.clientHeight);
  renderer.toneMapping         = THREE.ReinhardToneMapping;
  renderer.toneMappingExposure = 1.5;

  const scene  = new THREE.Scene();
  scene.background = new THREE.Color(0x03030a);

  const camera = new THREE.PerspectiveCamera(58, wrap.clientWidth / wrap.clientHeight, 0.05, 200);
  camera.position.set(0, 0, 6.5);

  /* ══════════════════════════════════════════════════════════════
     CLOTH PHYSICS — Position-Based Dynamics
     Reference: Müller et al. 2007 "Position Based Dynamics" JVCA
     ══════════════════════════════════════════════════════════════ */

  const W = 48, H = 32;                    /* lat/long grid divisions */
  const RADIUS   = 2.0;
  const STIFF    = 0.88;                   /* spring stiffness [0–1]  */
  const DAMP     = 0.987;                  /* velocity damping        */
  const PRESSURE = 0.010;                  /* force pulling toward rest sphere */
  const ITER     = 4;                      /* PBD constraint iterations */

  /* Build base sphere geometry (indexed, has UV) */
  const geo = new THREE.SphereGeometry(RADIUS, W, H);

  const posAttr = geo.attributes.position as THREE.BufferAttribute;
  const N = posAttr.count;

  /* Physics arrays — Verlet integration stores cur + prev positions */
  const cur  = new Float32Array(posAttr.array);   /* current positions  */
  const prev = new Float32Array(posAttr.array);   /* previous positions (velocity encoded) */
  const rest = new Float32Array(posAttr.array);   /* rest sphere positions */

  /* ── Extract unique edges from index buffer → spring list ─────── */
  interface Spring { a: number; b: number; len: number; }
  const springs: Spring[] = [];
  const edgeSet = new Set<number>();

  function addSpring(a: number, b: number) {
    const key = Math.min(a, b) * 100000 + Math.max(a, b);
    if (edgeSet.has(key)) return;
    edgeSet.add(key);
    const dx = cur[a*3]   - cur[b*3];
    const dy = cur[a*3+1] - cur[b*3+1];
    const dz = cur[a*3+2] - cur[b*3+2];
    springs.push({ a, b, len: Math.sqrt(dx*dx + dy*dy + dz*dz) });
  }

  const idx = (geo.index as THREE.BufferAttribute).array;
  for (let i = 0; i < idx.length; i += 3) {
    addSpring(idx[i], idx[i+1]);
    addSpring(idx[i+1], idx[i+2]);
    addSpring(idx[i], idx[i+2]);
  }

  /* ── PBD step ─────────────────────────────────────────────────── */
  let simTime = 0;

  function clothStep(dt: number) {
    simTime += dt;

    /* 1 — Apply forces + integrate (Verlet) */
    for (let i = 0; i < N; i++) {
      const ox = cur[i*3],   oy = cur[i*3+1], oz = cur[i*3+2];
      const px = prev[i*3], py = prev[i*3+1], pz = prev[i*3+2];

      /* Velocity from previous step */
      let vx = (ox - px) * DAMP;
      let vy = (oy - py) * DAMP;
      let vz = (oz - pz) * DAMP;

      /* Pressure: soft pull toward rest sphere surface */
      vx += (rest[i*3]   - ox) * PRESSURE;
      vy += (rest[i*3+1] - oy) * PRESSURE;
      vz += (rest[i*3+2] - oz) * PRESSURE;

      /* Wind: two crossing traveling waves → flag-like ripple
         Wave 1 travels in XZ plane, Wave 2 orthogonal */
      const rx = rest[i*3] / RADIUS;
      const ry = rest[i*3+1] / RADIUS;
      const rz = rest[i*3+2] / RADIUS;

      /* Wind: two crossing traveling waves → flag-like ripple
         Frequencies and phases tuned for organic cloth motion */
      const w1 = Math.sin(simTime * 3.8 + rz * 4.5 + rx * 2.0) * 0.0018;
      const w2 = Math.sin(simTime * 2.9 + rx * 3.5 - ry * 2.5) * 0.0013;
      const w3 = Math.cos(simTime * 2.2 + ry * 4.0 + rz * 1.8) * 0.0010;

      vx += w1 * rx + w2;
      vy += w1 * ry + w3;
      vz += w1 * rz + w2 * 0.5;

      prev[i*3]   = ox;
      prev[i*3+1] = oy;
      prev[i*3+2] = oz;

      cur[i*3]   = ox + vx;
      cur[i*3+1] = oy + vy;
      cur[i*3+2] = oz + vz;
    }

    /* 2 — Satisfy spring constraints (PBD iterations) */
    for (let iter = 0; iter < ITER; iter++) {
      for (const { a, b, len } of springs) {
        const ax = cur[a*3], ay = cur[a*3+1], az = cur[a*3+2];
        const bx = cur[b*3], by = cur[b*3+1], bz = cur[b*3+2];
        const dx = bx - ax, dy = by - ay, dz = bz - az;
        const d  = Math.sqrt(dx*dx + dy*dy + dz*dz);
        if (d < 1e-6) continue;
        const corr = (d - len) / d * 0.5 * STIFF;
        cur[a*3]   += dx * corr;  cur[a*3+1] += dy * corr;  cur[a*3+2] += dz * corr;
        cur[b*3]   -= dx * corr;  cur[b*3+1] -= dy * corr;  cur[b*3+2] -= dz * corr;
      }
    }

    /* 3 — Push updated positions back into geometry */
    (posAttr.array as Float32Array).set(cur);
    posAttr.needsUpdate = true;
    geo.computeVertexNormals();
  }

  /* ── Click impulse ────────────────────────────────────────────── */
  const hitSphere = new THREE.Mesh(
    new THREE.SphereGeometry(RADIUS, 32, 32),
    new THREE.MeshBasicMaterial({ visible: false })
  );
  scene.add(hitSphere);

  const raycaster = new THREE.Raycaster();
  const _m = new THREE.Vector2();

  wrap.addEventListener('click', (e: MouseEvent) => {
    const rect = wrap.getBoundingClientRect();
    _m.x =  ((e.clientX - rect.left) / rect.width)  * 2 - 1;
    _m.y = -((e.clientY - rect.top)  / rect.height) * 2 + 1;
    raycaster.setFromCamera(_m, camera);
    const hits = raycaster.intersectObject(hitSphere);
    if (!hits.length) return;

    const hp = hits[0].point;                /* click point on sphere */
    const IMPULSE_R   = 1.2;                 /* influence radius in world units */
    const IMPULSE_STR = 0.10;

    for (let i = 0; i < N; i++) {
      const dx = cur[i*3] - hp.x;
      const dy = cur[i*3+1] - hp.y;
      const dz = cur[i*3+2] - hp.z;
      const dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
      if (dist > IMPULSE_R) continue;

      /* Smooth falloff from click centre */
      const str = (1 - dist / IMPULSE_R) * (1 - dist / IMPULSE_R) * IMPULSE_STR;

      /* Outward impulse (radial from sphere centre) */
      const nx = cur[i*3]   / RADIUS;
      const ny = cur[i*3+1] / RADIUS;
      const nz = cur[i*3+2] / RADIUS;

      /* In Verlet: adding impulse = subtracting from prevPos */
      prev[i*3]   -= nx * str;
      prev[i*3+1] -= ny * str;
      prev[i*3+2] -= nz * str;
    }
  });

  /* ══════════════════════════════════════════════════════════════
     RENDERING — UV-based lattice (no barycentric needed)
     Grid lines created from UV coordinates in fragment shader
     ══════════════════════════════════════════════════════════════ */

  const VS = /* glsl */`
    varying vec2 vUV;
    varying vec3 vNorm;
    void main(){
      vUV  = uv;
      vNorm = normalize(normalMatrix * normal);
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `;

  /* Lattice width — fraction of each UV cell that is strut */
  const STRUT = 0.12;

  const LATTICE = /* glsl */`
    vec2  g       = fract(vUV * vec2(${W}.0, ${H}.0));
    float minEdge = min(min(g.x, g.y), min(1.0 - g.x, 1.0 - g.y));
    float aa      = max(fwidth(minEdge), 0.001);
    float strut   = 1.0 - smoothstep(${STRUT} - aa, ${STRUT} + aa, minEdge);
    if(strut < 0.02) discard;
  `;

  const FS_OUTER = /* glsl */`
    varying vec2 vUV;
    varying vec3 vNorm;
    void main(){
      ${LATTICE}
      vec3 dark   = vec3(0.04, 0.03, 0.10);
      vec3 bright = vec3(0.38, 0.38, 0.72);
      gl_FragColor = vec4(mix(dark, bright, pow(strut, 1.4)), strut);
    }
  `;

  const FS_INNER = /* glsl */`
    varying vec2 vUV;
    varying vec3 vNorm;
    void main(){
      ${LATTICE}
      vec3 dark   = vec3(0.50, 0.55, 0.60);
      vec3 bright = vec3(0.90, 0.93, 1.00);
      gl_FragColor = vec4(mix(dark, bright, pow(strut, 1.2)), strut);
    }
  `;

  /* Inner mesh — BackSide, renders first */
  const innerMat = new THREE.ShaderMaterial({
    vertexShader: VS, fragmentShader: FS_INNER,
    transparent: true, side: THREE.BackSide, depthWrite: true,
    polygonOffset: true, polygonOffsetFactor: 1, polygonOffsetUnits: 1,
  });
  const innerMesh = new THREE.Mesh(geo, innerMat);
  innerMesh.renderOrder = 0;
  scene.add(innerMesh);

  /* Outer mesh — FrontSide, renders second */
  const outerMat = new THREE.ShaderMaterial({
    vertexShader: VS, fragmentShader: FS_OUTER,
    transparent: true, side: THREE.FrontSide, depthWrite: true,
  });
  const outerMesh = new THREE.Mesh(geo, outerMat);
  outerMesh.renderOrder = 1;
  scene.add(outerMesh);

  /* ── Post-processing ──────────────────────────────────────────── */
  const composer = new EffectComposer(renderer);
  composer.addPass(new RenderPass(scene, camera));

  /* ── Resize ───────────────────────────────────────────────────── */
  function onResize() {
    const w = wrap.clientWidth, h = wrap.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
    composer.setSize(w, h);
  }
  const resizeObs = new ResizeObserver(onResize);
  resizeObs.observe(wrap);

  /* ── Animate ──────────────────────────────────────────────────── */
  let raf = 0;
  let t   = 0;

  function frame() {
    raf = requestAnimationFrame(frame);
    t += 0.004;

    /* Run cloth simulation */
    clothStep(0.016);

    /* Slowly orbit camera */
    camera.position.x = Math.sin(t * 0.18) * 6.5;
    camera.position.z = Math.cos(t * 0.18) * 6.5;
    camera.position.y = Math.sin(t * 0.09) * 2.0;
    camera.lookAt(0, 0, 0);

    composer.render();
  }
  frame();

  /* ── Cleanup ──────────────────────────────────────────────────── */
  document.addEventListener('astro:before-preparation', () => {
    cancelAnimationFrame(raf);
    resizeObs.disconnect();
    composer.dispose();
    renderer.dispose();
    geo.dispose();
    innerMat.dispose();
    outerMat.dispose();
    hitSphere.geometry.dispose();
  }, { once: true });
</script>
