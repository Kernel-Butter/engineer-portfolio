---
import ThinkRingV2 from './ThinkRingV2.astro';
---
<section id="hero" class="relative w-full h-screen min-h-[800px] flex items-center justify-center overflow-hidden bg-background">

  <ThinkRingV2 />

  <div class="absolute inset-0 bg-gradient-to-b from-background/40 via-background/60 to-background z-[1] pointer-events-none"></div>

  <div class="relative z-10 w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop flex flex-col justify-center h-full pt-20">
    <div class="max-w-4xl">

      <div class="eyebrow flex items-center gap-3 mb-6">
        <div class="w-2 h-2 rounded-full bg-secondary shadow-[0_0_8px_#44e2cd] animate-pulse"></div>
        <span data-cms="hero.eyebrow" class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">
          SYS.STATUS: ONLINE // READY
        </span>
      </div>

      <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface mb-8">
        <span data-cms="hero.headlinePrefix">ENGINEERING </span><span data-cms="hero.headlineAccent" class="text-primary">EXPERIENCE.</span>
      </h1>

      <p class="subheadline font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-12 border-l-2 border-primary/30 pl-6 py-2 bg-surface-container/20 backdrop-blur-sm">
        <span data-cms="hero.subheadline">Senior Frontend Engineer specializing in high-performance UI systems, WebGL, and AI-augmented delivery.</span>
        <br />
        <span data-cms="hero.tagline" class="text-primary font-code-snippet text-code-snippet mt-4 block">
          I sell engineered experience &mdash; not just websites.
        </span>
      </p>

      <div class="cta-row flex flex-col sm:flex-row gap-6 items-start sm:items-center">
        <a id="hero-cta" data-cms-href="hero.ctaHref" href="#contact"
           class="relative bg-primary text-on-primary font-code-snippet text-code-snippet px-8 py-4 rounded flex items-center gap-2 overflow-hidden hover:shadow-[0_0_20px_rgba(68,226,205,0.4)] transition-shadow duration-300">
          <span data-cms="hero.ctaLabel">INITIATE_DEPLOYMENT</span>
          <span class="material-symbols-outlined text-[18px]">rocket_launch</span>
          <span id="hero-shimmer" class="absolute inset-0 pointer-events-none" style="background:linear-gradient(105deg,transparent 38%,rgba(255,255,255,0.22) 50%,transparent 62%);transform:translateX(-100%)"></span>
        </a>
        <div class="flex items-center gap-4 text-on-surface-variant font-code-snippet text-code-snippet">
          <span class="material-symbols-outlined text-outline">memory</span>
          <span data-cms="hero.statusLabel">SYSTEM_ARCHITECT v4.2.0</span>
        </div>
      </div>

    </div>

    <div class="scroll-hint absolute bottom-12 left-margin-mobile md:left-margin-desktop flex items-center gap-4 animate-scroll opacity-80">
      <span class="font-label-sm text-label-sm text-outline tracking-[0.2em] uppercase origin-left rotate-90 hidden md:block absolute -left-4 -top-24 w-32">Scroll_Down</span>
      <div class="w-[1px] h-24 bg-gradient-to-b from-primary/50 to-transparent"></div>
    </div>

    <div class="absolute bottom-12 right-margin-mobile md:right-margin-desktop hidden lg:flex gap-2 opacity-30">
      <div class="w-16 h-16 border border-outline-variant/30 rounded flex items-center justify-center">
        <span class="material-symbols-outlined text-primary">terminal</span>
      </div>
      <div class="w-16 h-16 border border-outline-variant/30 rounded flex items-center justify-center">
        <span class="material-symbols-outlined text-secondary">database</span>
      </div>
      <div class="w-16 h-16 border border-outline-variant/30 rounded flex items-center justify-center">
        <span class="material-symbols-outlined text-tertiary">code_blocks</span>
      </div>
    </div>

  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { magneticButton, shimmerHover } from '../scripts/animations.js';

  // Hide elements immediately so they don't flash visible during #main-content fade-in
  gsap.set('#hero .eyebrow',     { opacity: 0, y: 10 });
  gsap.set('#hero h1',           { opacity: 0, y: 30 });
  gsap.set('#hero .subheadline', { opacity: 0, y: 20 });
  gsap.set('#hero .cta-row',     { opacity: 0, y: 20 });
  gsap.set('#hero .scroll-hint', { opacity: 0        });

  document.addEventListener('portfolio:ready', () => {
    gsap.timeline({ defaults: { ease: 'power3.out' } })
      .to('#hero .eyebrow',     { opacity: 1, y: 0, duration: 0.6 })
      .to('#hero h1',           { opacity: 1, y: 0, duration: 0.7 }, '-=0.3')
      .to('#hero .subheadline', { opacity: 1, y: 0, duration: 0.6 }, '-=0.4')
      .to('#hero .cta-row',     { opacity: 1, y: 0, duration: 0.5 }, '-=0.3')
      .to('#hero .scroll-hint', { opacity: 1,        duration: 0.4 }, '-=0.2');
  }, { once: true });

  const heroCta     = document.getElementById('hero-cta') as HTMLElement | null;
  const heroShimmer = document.getElementById('hero-shimmer') as HTMLElement | null;
  if (heroCta && heroShimmer) {
    magneticButton(heroCta);
    shimmerHover(heroCta, heroShimmer);
  }
</script>
