---
import ThinkRingV2 from './ThinkRingV2.astro';
import content from '../content/index.js';
const { hero, global } = content;
const identity = global.identity ?? {};
const show = { eyebrow: true, introduction: true, tagline: true, cta: true, status: true, ...hero.visibility };
---
<section id="hero" class="relative w-full h-screen min-h-[800px] flex items-center justify-center overflow-hidden bg-background">

  <ThinkRingV2 fill />

  <div class="absolute inset-0 bg-gradient-to-b from-background/40 via-background/60 to-background z-[1] pointer-events-none"></div>

  <div class="relative z-10 w-full max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop flex flex-col justify-center h-full pt-20">
    <div class="max-w-4xl">

      {show.eyebrow && <div class="eyebrow flex items-center gap-3 mb-6">
        {identity.profileImage && <img src={identity.profileImage} alt={identity.fullName || 'Profile photograph'} class="w-10 h-10 rounded-full object-cover border border-primary/40" />}
        <div class="w-2 h-2 rounded-full bg-secondary shadow-[0_0_8px_#44e2cd] animate-pulse"></div>
        <span data-cms="hero.eyebrow" class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">
          {[identity.fullName, hero.eyebrow].filter(Boolean).join(' // ')}
        </span>
      </div>}

      <h1 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-on-surface mb-8">
        <span>{hero.headlinePrefix?.trim()}</span>{' '}<span class="text-primary">{hero.headlineAccent?.trim()}</span>
      </h1>

      {(show.introduction || show.tagline) && <p class="subheadline font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-12 border-l-2 border-primary/30 pl-6 py-2 bg-surface-container/20 backdrop-blur-sm">
        {show.introduction && <span>{hero.subheadline}</span>}
        {show.introduction && show.tagline && <br />}
        {show.tagline && <span class="text-primary font-code-snippet text-code-snippet mt-4 block">{hero.tagline}</span>}
      </p>}

      <div class="cta-row flex flex-col sm:flex-row gap-6 items-start sm:items-center">
        {show.cta && <a id="hero-cta" href={hero.ctaHref}
           class="relative bg-primary text-on-primary font-code-snippet text-code-snippet px-8 py-4 rounded flex items-center gap-2 overflow-hidden hover:shadow-[0_0_20px_rgba(68,226,205,0.4)] transition-shadow duration-300">
          <span>{hero.ctaLabel}</span>
          <span class="material-symbols-outlined text-[18px]">rocket_launch</span>
          <span id="hero-shimmer" class="absolute inset-0 pointer-events-none" style="background:linear-gradient(105deg,transparent 38%,rgba(255,255,255,0.22) 50%,transparent 62%);transform:translateX(-100%)"></span>
        </a>}
        {show.status && <div class="flex items-center gap-4 text-on-surface-variant font-code-snippet text-code-snippet">
          <span class="material-symbols-outlined text-outline">memory</span>
          <span>{[identity.professionalTitle, hero.statusLabel, identity.location, identity.timezone].filter(Boolean).join(' · ')}</span>
        </div>}
      </div>

    </div>

    <div class="scroll-hint absolute bottom-12 left-margin-mobile md:left-margin-desktop flex items-center gap-4 animate-scroll opacity-80">
      <span class="font-label-sm text-label-sm text-outline tracking-[0.2em] uppercase origin-left rotate-90 hidden md:block absolute -left-4 -top-24 w-32">Scroll_Down</span>
      <div class="w-[1px] h-24 bg-gradient-to-b from-primary/50 to-transparent"></div>
    </div>

    <div class="absolute bottom-12 right-margin-mobile md:right-margin-desktop hidden lg:flex gap-2 opacity-30">
      <div class="w-16 h-16 border border-outline-variant/30 rounded flex items-center justify-center">
        <span class="material-symbols-outlined text-primary">terminal</span>
      </div>
      <div class="w-16 h-16 border border-outline-variant/30 rounded flex items-center justify-center">
        <span class="material-symbols-outlined text-secondary">database</span>
      </div>
      <div class="w-16 h-16 border border-outline-variant/30 rounded flex items-center justify-center">
        <span class="material-symbols-outlined text-tertiary">code_blocks</span>
      </div>
    </div>

  </div>
</section>

<style>
  /* Smooth weight transition on each h1 character so cursor movement
     doesn't produce frame-by-frame snapping between weight values. */
  #hero .hero-vfp {
    display: inline-block;
    transition: font-variation-settings 0.09s ease-out;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { magneticButton, shimmerHover } from '../scripts/animations.js';

  document.addEventListener('astro:page-load', () => {
    // ── Split h1 into per-character spans (before GSAP hides the element) ──
    // Reading textContent at runtime means any CMS change to headlinePrefix
    // or headlineAccent is automatically reflected — no hardcoded strings here.
    const h1 = document.querySelector<HTMLElement>('#hero h1');
    if (h1) {
      h1.querySelectorAll<HTMLElement>(':scope > span').forEach(span => {
        const text = span.textContent ?? '';
        // Preserve the span's class (e.g. text-primary on the accent word) so
        // colour inheritance still reaches every child .hero-vfp span.
        span.innerHTML = text.split('').map(c =>
          c === ' '
            ? '&nbsp;'
            : `<span class="hero-vfp" style="font-variation-settings:'wght' 700">${c}</span>`
        ).join('');
      });
    }

    // Hide elements immediately so they don't flash visible during #main-content fade-in
    gsap.set('#hero .eyebrow',     { opacity: 0, y: 10 });
    gsap.set('#hero h1',           { opacity: 0, y: 30 });
    gsap.set('#hero .subheadline', { opacity: 0, y: 20 });
    gsap.set('#hero .cta-row',     { opacity: 0, y: 20 });
    gsap.set('#hero .scroll-hint', { opacity: 0        });

    document.addEventListener('portfolio:ready', () => {
      gsap.timeline({ defaults: { ease: 'power3.out' } })
        .to('#hero .eyebrow',     { opacity: 1, y: 0, duration: 0.6 })
        .to('#hero h1',           { opacity: 1, y: 0, duration: 0.7 }, '-=0.3')
        .to('#hero .subheadline', { opacity: 1, y: 0, duration: 0.6 }, '-=0.4')
        .to('#hero .cta-row',     { opacity: 1, y: 0, duration: 0.5 }, '-=0.3')
        .to('#hero .scroll-hint', { opacity: 1,        duration: 0.4 }, '-=0.2');

      // ── Bind VFP after h1 finishes its entry animation (~700 ms) ─────────
      // Proximity effect: chars near the cursor grow heavier (→ 800),
      // chars far away soften (→ 200). Quadratic ease concentrates the
      // effect at close range for a sharp "spotlight" feel.
      setTimeout(bindHeroVFP, 700);
    }, { once: true });

    function bindHeroVFP() {
      const hero     = document.getElementById('hero');
      const chars    = hero?.querySelectorAll<HTMLElement>('.hero-vfp');
      if (!hero || !chars?.length) return;

      const RADIUS = 160;
      const MIN_W  = 200;
      const MAX_W  = 800;
      const BASE_W = 700;

      hero.addEventListener('mousemove', e => {
        chars.forEach(char => {
          const r    = char.getBoundingClientRect();
          const cx   = r.left + r.width  / 2;
          const cy   = r.top  + r.height / 2;
          const dist = Math.hypot(e.clientX - cx, e.clientY - cy);
          const t    = Math.max(0, 1 - dist / RADIUS);
          const w    = Math.round(MIN_W + t * t * (MAX_W - MIN_W));
          char.style.fontVariationSettings = `'wght' ${w}`;
        });
      });

      hero.addEventListener('mouseleave', () => {
        chars.forEach(char => {
          char.style.fontVariationSettings = `'wght' ${BASE_W}`;
        });
      });
    }

    const heroCta     = document.getElementById('hero-cta') as HTMLElement | null;
    const heroShimmer = document.getElementById('hero-shimmer') as HTMLElement | null;
    if (heroCta && heroShimmer) {
      magneticButton(heroCta);
      shimmerHover(heroCta, heroShimmer);
    }
  });
</script>
