---
const transitions = [
  {
    id:         'glitch',
    name:       'GLITCH_SPLIT',
    accent:     '#c0c1ff',
    duration:   '350ms',
    complexity: 'Medium',
    desc:       'RGB channels separate briefly, white flash snaps to new page. Most on-brand with the preloader glitch text.',
  },
  {
    id:         'scanline',
    name:       'SCANLINE_CURTAIN',
    accent:     '#44e2cd',
    duration:   '200ms',
    complexity: 'Low',
    desc:       'A single bright line sweeps top → bottom, revealing the next page underneath. Military HUD / CRT feel.',
  },
  {
    id:         'wipe',
    name:       'VERTICAL_WIPE',
    accent:     '#4edea3',
    duration:   '400ms',
    complexity: 'Low',
    desc:       'Two panels close from left and right edges simultaneously, then split apart revealing new content.',
  },
  {
    id:         'flash',
    name:       'TERMINAL_FLASH',
    accent:     '#ffc542',
    duration:   '250ms',
    complexity: 'Low',
    desc:       'Solid black slams in with one line of typing monospace text, then instantly cuts to the new page.',
  },
  {
    id:         'dissolve',
    name:       'BLOCK_DISSOLVE',
    accent:     '#ff7eb3',
    duration:   '500ms',
    complexity: 'High',
    desc:       'Screen shatters into a pixel grid, blocks blink out in a staggered diagonal wave revealing new content.',
  },
];
---

<section class="ts-section py-section-padding px-margin-mobile md:px-margin-desktop">
  <div class="w-full max-w-container-max mx-auto">

    <header class="mb-14">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">// PAGE_TRANSITIONS</span>
      </div>
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-3">Transition Showcase</h2>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
        All 5 candidate transitions previewed in real time. Hover any card to pause the loop.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {transitions.map(t => (
        <div class="ts-card" data-transition={t.id}>

          <!-- ── PREVIEW BOX ─────────────────── -->
          <div class="ts-preview" style={`--accent:${t.accent}`}>

            <!-- Page A mockup -->
            <div class="ts-page ts-a">
              <div class="ts-mock-nav"></div>
              <div class="ts-mock-content">
                <div class="ts-mock-h" style="width:55%"></div>
                <div class="ts-mock-h" style="width:38%;opacity:.5;margin-top:6px"></div>
                <div class="ts-mock-bar" style="width:80%;margin-top:12px"></div>
                <div class="ts-mock-bar" style="width:65%"></div>
                <div class="ts-mock-bar" style="width:72%"></div>
                <div class="ts-mock-bar" style="width:50%"></div>
              </div>
              <div class="ts-page-label" style={`color:${t.accent}`}>PAGE_A</div>
            </div>

            <!-- Page B mockup (hidden initially) -->
            <div class="ts-page ts-b">
              <div class="ts-mock-nav" style="opacity:.7"></div>
              <div class="ts-mock-content">
                <div class="ts-mock-h" style="width:70%"></div>
                <div class="ts-mock-h" style="width:45%;opacity:.5;margin-top:6px"></div>
                <div class="ts-mock-bar" style="width:60%;margin-top:12px"></div>
                <div class="ts-mock-bar" style="width:88%"></div>
                <div class="ts-mock-bar" style="width:45%"></div>
                <div class="ts-mock-bar" style="width:75%"></div>
              </div>
              <div class="ts-page-label" style={`color:${t.accent}`}>PAGE_B</div>
            </div>

            <!-- ── TRANSITION-SPECIFIC OVERLAYS ── -->

            {t.id === 'glitch' && (
              <>
                <div class="ts-glitch-r ts-page ts-a"></div>
                <div class="ts-glitch-b ts-page ts-a"></div>
                <div class="ts-flash"></div>
              </>
            )}

            {t.id === 'scanline' && (
              <div class="ts-scanline-bar"></div>
            )}

            {t.id === 'wipe' && (
              <>
                <div class="ts-wipe-l"></div>
                <div class="ts-wipe-r"></div>
              </>
            )}

            {t.id === 'flash' && (
              <>
                <div class="ts-flash-overlay">
                  <span class="ts-flash-text"></span>
                </div>
              </>
            )}

            {t.id === 'dissolve' && (
              <div class="ts-dissolve-grid">
                {Array.from({ length: 80 }).map((_, i) => (
                  <div class="ts-dissolve-cell" data-cell={i}></div>
                ))}
              </div>
            )}

          </div>

          <!-- ── CARD INFO ──────────────────── -->
          <div class="ts-info">
            <div class="flex items-start justify-between gap-3 mb-2">
              <h3
                class="font-headline-sm text-headline-sm text-on-surface"
                style={`color:${t.accent}`}
              >{t.name}</h3>
              <div class="flex gap-2 flex-shrink-0 mt-0.5">
                <span class="ts-tag">{t.duration}</span>
                <span class="ts-tag" style={
                  t.complexity === 'Low'    ? 'color:#4edea3;border-color:#4edea330' :
                  t.complexity === 'Medium' ? 'color:#ffc542;border-color:#ffc54230' :
                                             'color:#ff7eb3;border-color:#ff7eb330'
                }>{t.complexity}</span>
              </div>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant/60 leading-relaxed text-[12px]">{t.desc}</p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* ── CARD ────────────────────────────────── */
  .ts-card {
    display: flex;
    flex-direction: column;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.08);
    background: #0d0d0d;
  }

  /* ── PREVIEW BOX ─────────────────────────── */
  .ts-preview {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #080808;
    cursor: pointer;
  }

  /* ── PAGE MOCKUPS ────────────────────────── */
  .ts-page {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 14px;
  }
  .ts-b { z-index: 0; }
  .ts-a { z-index: 1; }

  .ts-mock-nav {
    width: 100%; height: 8px;
    background: rgba(255,255,255,.06);
    border-radius: 2px;
    margin-bottom: 12px;
    flex-shrink: 0;
  }
  .ts-mock-content { flex: 1; display: flex; flex-direction: column; gap: 5px; }
  .ts-mock-h {
    height: 10px;
    background: var(--accent, #c0c1ff);
    opacity: .35;
    border-radius: 2px;
  }
  .ts-mock-bar {
    height: 5px;
    background: rgba(255,255,255,.1);
    border-radius: 1px;
  }
  .ts-page-label {
    position: absolute;
    bottom: 10px; right: 12px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    opacity: .4;
  }

  /* ── GLITCH overlays ─────────────────────── */
  .ts-glitch-r { z-index: 2; mix-blend-mode: screen; opacity: 0; filter: url(#glitch-r) drop-shadow(2px 0 0 #f00); }
  .ts-glitch-b { z-index: 2; mix-blend-mode: screen; opacity: 0; filter: drop-shadow(-2px 0 0 #00f); }
  .ts-flash    { position:absolute;inset:0;z-index:5;background:#fff;opacity:0;pointer-events:none; }

  /* ── SCANLINE bar ────────────────────────── */
  .ts-scanline-bar {
    position: absolute; left: 0; right: 0; top: -3px;
    height: 3px; z-index: 5;
    background: linear-gradient(90deg, transparent, var(--accent, #44e2cd), transparent);
    box-shadow: 0 0 10px 2px var(--accent, #44e2cd);
    pointer-events: none;
  }

  /* ── WIPE panels ─────────────────────────── */
  .ts-wipe-l, .ts-wipe-r {
    position: absolute; inset-block: 0; z-index: 5;
    width: 0; background: #0a0a0a;
    pointer-events: none;
  }
  .ts-wipe-l { left:0;  transform-origin: left center;  }
  .ts-wipe-r { right:0; transform-origin: right center; }

  /* ── FLASH overlay ───────────────────────── */
  .ts-flash-overlay {
    position: absolute; inset: 0; z-index: 5;
    background: #000;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
  }
  .ts-flash-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px; letter-spacing: .14em; text-transform: uppercase;
    color: rgba(255,197,66,.8);
    white-space: nowrap;
  }

  /* ── DISSOLVE grid ───────────────────────── */
  .ts-dissolve-grid {
    position: absolute; inset: 0; z-index: 5;
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    grid-template-rows: repeat(8, 1fr);
    pointer-events: none;
  }
  .ts-dissolve-cell {
    background: #080808;
    opacity: 1;
  }

  /* ── CARD INFO ───────────────────────────── */
  .ts-info {
    padding: 16px 18px 18px;
    border-top: 1px solid rgba(255,255,255,.06);
  }
  .ts-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    padding: 2px 7px; border-radius: 4px;
    border: 1px solid rgba(255,255,255,.12);
    color: rgba(255,255,255,.4);
  }
</style>

<script>
  import { gsap } from 'gsap';

  function buildTimelines() {
    document.querySelectorAll<HTMLElement>('.ts-card').forEach(card => {
      const id      = card.dataset.transition!;
      const preview = card.querySelector<HTMLElement>('.ts-preview')!;
      const pageA   = card.querySelector<HTMLElement>('.ts-a')!;
      const pageB   = card.querySelector<HTMLElement>('.ts-b')!;

      let tl: gsap.core.Timeline;

      /* ── helpers ── */
      const reset = () => {
        gsap.set(pageA, { opacity: 1, x: 0, y: 0, clipPath: 'none', zIndex: 1 });
        gsap.set(pageB, { opacity: 1, x: 0, y: 0, clipPath: 'none', zIndex: 0 });
      };

      /* ══════════════════════════════════════════════
         1. GLITCH SPLIT
      ══════════════════════════════════════════════ */
      if (id === 'glitch') {
        const glitchR = card.querySelector<HTMLElement>('.ts-glitch-r')!;
        const glitchB = card.querySelector<HTMLElement>('.ts-glitch-b')!;
        const flash   = card.querySelector<HTMLElement>('.ts-flash')!;

        tl = gsap.timeline({ repeat: -1, repeatDelay: 1.4, paused: true,
          onRepeat: reset });

        tl
          // brief RGB channel split on Page A
          .set([glitchR, glitchB], { opacity: 0 })
          .to(glitchR, { opacity: .6, x:  5, duration: .06, ease: 'none' })
          .to(glitchB, { opacity: .6, x: -5, duration: .06, ease: 'none' }, '<')
          .to(glitchR, { opacity: 0, x: 0, duration: .05 })
          .to(glitchB, { opacity: 0, x: 0, duration: .05 }, '<')
          // second stronger glitch burst
          .to(glitchR, { opacity: .8, x:  8, duration: .04, ease: 'none' }, '+=.05')
          .to(glitchB, { opacity: .8, x: -8, duration: .04, ease: 'none' }, '<')
          .to(pageA,   { y: -4, duration: .04, ease: 'none' }, '<')
          .to(glitchR, { opacity: 0, x: 0, duration: .03 })
          .to(glitchB, { opacity: 0, x: 0, duration: .03 }, '<')
          .to(pageA,   { y: 0,  duration: .03 }, '<')
          // white flash → swap
          .to(flash, { opacity: 1, duration: .05, ease: 'none' })
          .set(pageA,  { zIndex: 0 })
          .set(pageB,  { zIndex: 1 })
          .to(flash, { opacity: 0, duration: .12, ease: 'power2.out' })
          // hold on B, then swap back for next loop
          .to({}, { duration: 1 })
          .set(pageA, { zIndex: 1 })
          .set(pageB, { zIndex: 0 });
      }

      /* ══════════════════════════════════════════════
         2. SCANLINE CURTAIN
      ══════════════════════════════════════════════ */
      else if (id === 'scanline') {
        const line = card.querySelector<HTMLElement>('.ts-scanline-bar')!;

        gsap.set(line, { top: '-3px' });
        gsap.set(pageB, { clipPath: 'inset(0 0 100% 0)', zIndex: 2 });

        tl = gsap.timeline({ repeat: -1, repeatDelay: 1.4, paused: true,
          onRepeat() {
            gsap.set(line, { top: '-3px' });
            gsap.set(pageA, { zIndex: 1 });
            gsap.set(pageB, { clipPath: 'inset(0 0 100% 0)', zIndex: 2 });
          }
        });

        tl
          .to(line,  { top: '100%', duration: .22, ease: 'none' })
          .to(pageB, { clipPath: 'inset(0 0 0% 0)', duration: .22, ease: 'none' }, '<')
          .to({}, { duration: 1 })
          // reset: B becomes "A" for next loop
          .set(pageA, { zIndex: 0 })
          .set(pageB, { clipPath: 'none', zIndex: 1 });
      }

      /* ══════════════════════════════════════════════
         3. VERTICAL WIPE
      ══════════════════════════════════════════════ */
      else if (id === 'wipe') {
        const wL = card.querySelector<HTMLElement>('.ts-wipe-l')!;
        const wR = card.querySelector<HTMLElement>('.ts-wipe-r')!;

        gsap.set([wL, wR], { width: '0%' });

        tl = gsap.timeline({ repeat: -1, repeatDelay: 1.4, paused: true,
          onRepeat() {
            gsap.set([wL, wR], { width: '0%' });
            gsap.set(pageA, { zIndex: 1 });
            gsap.set(pageB, { zIndex: 0 });
          }
        });

        tl
          // panels close in
          .to([wL, wR], { width: '50.5%', duration: .22, ease: 'power2.inOut' })
          // swap pages behind panels
          .set(pageA, { zIndex: 0 })
          .set(pageB, { zIndex: 1 })
          // panels open out
          .to([wL, wR], { width: '0%', duration: .22, ease: 'power2.inOut' })
          .to({}, { duration: 1 });
      }

      /* ══════════════════════════════════════════════
         4. TERMINAL FLASH
      ══════════════════════════════════════════════ */
      else if (id === 'flash') {
        const overlay = card.querySelector<HTMLElement>('.ts-flash-overlay')!;
        const text    = card.querySelector<HTMLElement>('.ts-flash-text')!;
        const LABEL   = '> NAVIGATING MODULE...';

        gsap.set(overlay, { opacity: 0 });
        gsap.set(text,    { textContent: '' });

        tl = gsap.timeline({ repeat: -1, repeatDelay: 1.4, paused: true,
          onRepeat() {
            gsap.set(overlay, { opacity: 0 });
            gsap.set(text, { textContent: '' });
            gsap.set(pageA, { zIndex: 1 });
            gsap.set(pageB, { opacity: 1, zIndex: 0 });
          }
        });

        // Type label character by character
        const chars = LABEL.split('');
        tl.to(overlay, { opacity: 1, duration: .04, ease: 'none' });
        chars.forEach((ch, i) => {
          tl.add(() => { text.textContent = LABEL.slice(0, i + 1); }, `+=${0.018}`);
        });

        tl
          .to({}, { duration: .18 })
          .set(pageA, { zIndex: 0 })
          .set(pageB, { zIndex: 2 })
          .to(overlay, { opacity: 0, duration: .1, ease: 'power2.out' })
          .to({}, { duration: 1 });
      }

      /* ══════════════════════════════════════════════
         5. BLOCK DISSOLVE
      ══════════════════════════════════════════════ */
      else if (id === 'dissolve') {
        const cells = card.querySelectorAll<HTMLElement>('.ts-dissolve-cell');

        gsap.set(cells, { opacity: 1 });

        tl = gsap.timeline({ repeat: -1, repeatDelay: 1.4, paused: true,
          onRepeat() {
            gsap.set(cells, { opacity: 1 });
            gsap.set(pageA, { zIndex: 1 });
            gsap.set(pageB, { zIndex: 0 });
          }
        });

        // Diagonal stagger: cell (col + row) order
        const cols = 10, rows = 8;
        const sorted = Array.from(cells).sort((a, b) => {
          const ai = Number(a.dataset.cell), bi = Number(b.dataset.cell);
          const aWave = (ai % cols) + Math.floor(ai / cols);
          const bWave = (bi % cols) + Math.floor(bi / cols);
          return aWave - bWave;
        });

        tl
          .set(pageB, { zIndex: 2 })
          .to(sorted, {
            opacity: 0,
            duration: .06,
            stagger: { each: .025, from: 'start' },
            ease: 'none',
          })
          .to({}, { duration: 1 })
          // dissolve back for next loop
          .to(sorted, {
            opacity: 1,
            duration: .04,
            stagger: { each: .018, from: 'end' },
            ease: 'none',
          })
          .set(pageA, { zIndex: 0 });
      }

      if (!tl!) return;

      // Auto-play
      tl.play();

      // Pause on hover
      preview.addEventListener('mouseenter', () => tl.pause());
      preview.addEventListener('mouseleave', () => tl.play());
    });
  }

  document.addEventListener('astro:page-load', buildTimelines);
</script>
