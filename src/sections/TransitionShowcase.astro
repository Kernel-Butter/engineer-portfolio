---
const transitions = [
  {
    id: 'glitch', name: 'GLITCH_SPLIT', accent: '#c0c1ff', duration: '350ms', complexity: 'Medium',
    desc: 'RGB channels separate briefly, white flash snaps to new page.',
  },
  {
    id: 'scanline', name: 'SCANLINE_CURTAIN', accent: '#44e2cd', duration: '200ms', complexity: 'Low',
    desc: 'Bright horizontal line sweeps top → bottom, revealing the next page underneath.',
  },
  {
    id: 'wipe', name: 'VERTICAL_WIPE', accent: '#4edea3', duration: '400ms', complexity: 'Low',
    desc: 'Two panels close from left + right edges simultaneously, split to reveal new content.',
  },
  {
    id: 'flash', name: 'TERMINAL_FLASH', accent: '#ffc542', duration: '250ms', complexity: 'Low',
    desc: 'Solid black slams in with typing monospace text, then instantly cuts to the new page.',
  },
  {
    id: 'dissolve', name: 'BLOCK_DISSOLVE', accent: '#ff7eb3', duration: '500ms', complexity: 'High',
    desc: 'Screen shatters into a pixel grid, blocks blink out in a staggered diagonal wave.',
  },
  {
    id: 'crt', name: 'CRT_POWEROFF', accent: '#c0c1ff', duration: '400ms', complexity: 'Low',
    desc: 'Screen collapses vertically to a bright line (CRT shutoff), then expands on the new page.',
  },
  {
    id: 'venetian', name: 'VENETIAN_BLIND', accent: '#44e2cd', duration: '300ms', complexity: 'Low',
    desc: 'Horizontal strips slide in alternating left/right to cover old page, then reverse out.',
  },
  {
    id: 'iris', name: 'RADIAL_IRIS', accent: '#4edea3', duration: '350ms', complexity: 'Low',
    desc: 'Circular mask closes to a point at center (camera iris), then opens on the new page.',
  },
  {
    id: 'static', name: 'SIGNAL_DROPOUT', accent: '#ffc542', duration: '300ms', complexity: 'Medium',
    desc: 'Full-screen TV static noise takes over briefly, new page fades in like a signal locking.',
  },
  {
    id: 'combo', name: 'DISSOLVE_BOOT_HEX', accent: '#c0c1ff', duration: '490ms', complexity: 'High',
    desc: 'Blocks shatter out → terminal boot lines run in the void → hex cells open from center revealing new page.',
  },
];
---

<section class="ts-section py-section-padding px-margin-mobile md:px-margin-desktop">
  <div class="w-full max-w-container-max mx-auto">

    <header class="mb-14">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">// PAGE_TRANSITIONS</span>
      </div>
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-3">Transition Showcase</h2>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
        9 candidate transitions previewed live. Hover any card to pause.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {transitions.map(t => (
        <div class="ts-card" data-transition={t.id}>

          <!-- ── PREVIEW ─────────────────────── -->
          <div class="ts-preview" style={`--accent:${t.accent}`}>

            <!-- Page A -->
            <div class="ts-page ts-a">
              <div class="ts-mock-nav"></div>
              <div class="ts-mock-content">
                <div class="ts-mock-h" style="width:55%"></div>
                <div class="ts-mock-h ts-mock-h2" style="width:38%"></div>
                <div class="ts-mock-bar" style="width:80%"></div>
                <div class="ts-mock-bar" style="width:65%"></div>
                <div class="ts-mock-bar" style="width:72%"></div>
                <div class="ts-mock-bar" style="width:50%"></div>
              </div>
              <div class="ts-page-label" style={`color:${t.accent}`}>PAGE_A</div>
            </div>

            <!-- Page B -->
            <div class="ts-page ts-b">
              <div class="ts-mock-nav" style="opacity:.6"></div>
              <div class="ts-mock-content">
                <div class="ts-mock-h" style="width:70%"></div>
                <div class="ts-mock-h ts-mock-h2" style="width:45%"></div>
                <div class="ts-mock-bar" style="width:60%"></div>
                <div class="ts-mock-bar" style="width:88%"></div>
                <div class="ts-mock-bar" style="width:45%"></div>
                <div class="ts-mock-bar" style="width:75%"></div>
              </div>
              <div class="ts-page-label" style={`color:${t.accent}`}>PAGE_B</div>
            </div>

            <!-- Per-transition overlays -->

            {t.id === 'glitch' && (
              <>
                <div class="ts-glitch-r ts-page ts-a"></div>
                <div class="ts-glitch-b ts-page ts-a"></div>
                <div class="ts-flash"></div>
              </>
            )}

            {t.id === 'scanline' && <div class="ts-scanline-bar"></div>}

            {t.id === 'wipe' && (
              <>
                <div class="ts-wipe-l"></div>
                <div class="ts-wipe-r"></div>
              </>
            )}

            {t.id === 'flash' && (
              <div class="ts-flash-overlay">
                <span class="ts-flash-text"></span>
              </div>
            )}

            {t.id === 'dissolve' && (
              <div class="ts-dissolve-grid">
                {Array.from({ length: 80 }).map((_, i) => (
                  <div class="ts-dissolve-cell" data-cell={i}></div>
                ))}
              </div>
            )}

            {t.id === 'crt' && <div class="ts-crt-line"></div>}

            {t.id === 'venetian' && (
              <div class="ts-venetian-strips">
                {Array.from({ length: 7 }).map((_, i) => (
                  <div class="ts-vstrip" data-i={i}
                    style={`top:${(i / 7) * 100}%;height:${100 / 7 + 0.5}%`}></div>
                ))}
              </div>
            )}

            {t.id === 'static' && (
              <div class="ts-static-overlay">
                <canvas class="ts-static-canvas" width="320" height="180"></canvas>
              </div>
            )}

            {t.id === 'combo' && (
              <>
                {/* Dark boot overlay - sits between dissolve-out and hex-reveal */}
                <div class="ts-combo-boot">
                  {[
                    'UNLOAD /home ......... 200ms',
                    'FLUSH cache .......... 12ms',
                    'INIT route ........... 4ms',
                    'FETCH assets ......... 38ms',
                    'RENDER tree .......... 9ms',
                    'COMMIT .............. [OK]',
                  ].map(line => (
                    <div class="ts-boot-line">{line}</div>
                  ))}
                </div>

                {/* Hex dissolve cells - cover Page A, blink out to reveal boot */}
                <div class="ts-combo-blocks">
                  {Array.from({ length: 40 }).map((_, i) => (
                    <div class="ts-cb-cell" data-cbcell={i}></div>
                  ))}
                </div>

                {/* Hex reveal cells - cover Page B, blink out from center */}
                <div class="ts-combo-hex">
                  {Array.from({ length: 40 }).map((_, i) => (
                    <div class="ts-hex-cell" data-hcell={i}></div>
                  ))}
                </div>
              </>
            )}

          </div>

          <!-- ── CARD INFO ──────────────────── -->
          <div class="ts-info">
            <div class="flex items-start justify-between gap-3 mb-2">
              <h3 class="font-headline-sm text-headline-sm" style={`color:${t.accent}`}>{t.name}</h3>
              <div class="flex gap-2 flex-shrink-0 mt-0.5">
                <span class="ts-tag">{t.duration}</span>
                <span class="ts-tag" style={
                  t.complexity === 'Low'    ? 'color:#4edea3;border-color:#4edea330' :
                  t.complexity === 'Medium' ? 'color:#ffc542;border-color:#ffc54230' :
                                             'color:#ff7eb3;border-color:#ff7eb330'
                }>{t.complexity}</span>
              </div>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant/60 leading-relaxed text-[12px]">{t.desc}</p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .ts-card {
    display:flex;flex-direction:column;
    border-radius:12px;overflow:hidden;
    border:1px solid rgba(255,255,255,.08);background:#0d0d0d;
  }
  .ts-preview {
    position:relative;aspect-ratio:16/9;
    overflow:hidden;background:#080808;cursor:pointer;
  }
  .ts-page { position:absolute;inset:0;display:flex;flex-direction:column;padding:14px; }
  .ts-b { z-index:0; }
  .ts-a { z-index:1; }

  .ts-mock-nav {
    width:100%;height:8px;background:rgba(255,255,255,.06);
    border-radius:2px;margin-bottom:12px;flex-shrink:0;
  }
  .ts-mock-content { flex:1;display:flex;flex-direction:column;gap:5px; }
  .ts-mock-h  { height:10px;background:var(--accent,#c0c1ff);opacity:.35;border-radius:2px; }
  .ts-mock-h2 { opacity:.18;margin-top:4px; }
  .ts-mock-bar { height:5px;background:rgba(255,255,255,.1);border-radius:1px; }
  .ts-page-label {
    position:absolute;bottom:10px;right:12px;
    font-family:'JetBrains Mono',monospace;
    font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;opacity:.4;
  }

  /* glitch */
  .ts-glitch-r { z-index:2;mix-blend-mode:screen;opacity:0;filter:drop-shadow(4px 0 0 #f00); }
  .ts-glitch-b { z-index:2;mix-blend-mode:screen;opacity:0;filter:drop-shadow(-4px 0 0 #00f); }
  .ts-flash    { position:absolute;inset:0;z-index:6;background:#fff;opacity:0;pointer-events:none; }

  /* scanline */
  .ts-scanline-bar {
    position:absolute;left:0;right:0;top:-3px;height:3px;z-index:5;
    background:linear-gradient(90deg,transparent,var(--accent,#44e2cd),transparent);
    box-shadow:0 0 10px 2px var(--accent,#44e2cd);pointer-events:none;
  }

  /* wipe */
  .ts-wipe-l,.ts-wipe-r {
    position:absolute;inset-block:0;z-index:5;width:0;background:#0a0a0a;pointer-events:none;
  }
  .ts-wipe-l { left:0; }
  .ts-wipe-r { right:0; }

  /* flash */
  .ts-flash-overlay {
    position:absolute;inset:0;z-index:5;background:#000;
    display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;
  }
  .ts-flash-text {
    font-family:'JetBrains Mono',monospace;
    font-size:9px;letter-spacing:.14em;text-transform:uppercase;
    color:rgba(255,197,66,.8);white-space:nowrap;
  }

  /* dissolve */
  .ts-dissolve-grid {
    position:absolute;inset:0;z-index:5;
    display:grid;grid-template-columns:repeat(10,1fr);grid-template-rows:repeat(8,1fr);
    pointer-events:none;
  }
  .ts-dissolve-cell { background:#080808; }

  /* crt */
  .ts-crt-line {
    position:absolute;left:0;right:0;top:50%;z-index:6;height:2px;
    background:linear-gradient(90deg,transparent 0%,rgba(255,255,255,.9) 30%,#fff 50%,rgba(255,255,255,.9) 70%,transparent);
    box-shadow:0 0 8px 3px rgba(255,255,255,.6);
    opacity:0;pointer-events:none;transform:translateY(-50%);
  }

  /* venetian */
  .ts-venetian-strips { position:absolute;inset:0;z-index:5;pointer-events:none; }
  .ts-vstrip { position:absolute;left:0;right:0;background:#0a0a0a; }

  /* static */
  .ts-static-overlay { position:absolute;inset:0;z-index:5;opacity:0;pointer-events:none; }
  .ts-static-canvas  { width:100%;height:100%;display:block; }

  /* combo: boot overlay */
  .ts-combo-boot {
    position:absolute;inset:0;z-index:5;
    background:#060606;
    display:flex;flex-direction:column;justify-content:center;padding:16px 18px;gap:5px;
  }
  .ts-boot-line {
    font-family:'JetBrains Mono',monospace;
    font-size:8px;letter-spacing:.08em;
    color:rgba(192,193,255,.5);opacity:0;white-space:nowrap;
  }
  .ts-boot-line:last-child { color:rgba(78,222,163,.7); }

  /* combo: hex dissolve cells (out-phase) */
  .ts-combo-blocks { position:absolute;inset:0;z-index:6;pointer-events:none; }
  .ts-cb-cell {
    position:absolute;
    clip-path:polygon(25% 0%,75% 0%,100% 50%,75% 100%,25% 100%,0% 50%);
    background:#080808;
    transform:scale(.9);
    transform-origin:center center;
  }

  /* combo: hex reveal cells */
  .ts-combo-hex { position:absolute;inset:0;z-index:10;pointer-events:none; }
  .ts-hex-cell {
    position:absolute;
    clip-path:polygon(25% 0%,75% 0%,100% 50%,75% 100%,25% 100%,0% 50%);
    background:#080808;
    transform:scale(.9);
    transform-origin:center center;
  }

  /* info */
  .ts-info { padding:16px 18px 18px;border-top:1px solid rgba(255,255,255,.06); }
  .ts-tag {
    font-family:'JetBrains Mono',monospace;
    font-size:9px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
    padding:2px 7px;border-radius:4px;
    border:1px solid rgba(255,255,255,.12);color:rgba(255,255,255,.4);
  }
</style>

<script>
  import { gsap } from 'gsap';

  function buildTimelines() {
    document.querySelectorAll<HTMLElement>('.ts-card').forEach(card => {
      const id    = card.dataset.transition!;
      const prev  = card.querySelector<HTMLElement>('.ts-preview')!;
      const pageA = card.querySelector<HTMLElement>('.ts-a')!;
      const pageB = card.querySelector<HTMLElement>('.ts-b')!;

      const resetPages = () => {
        gsap.set(pageA, { opacity:1, x:0, y:0, scaleY:1, clipPath:'none', zIndex:1 });
        gsap.set(pageB, { opacity:1, x:0, y:0, scaleY:1, clipPath:'none', zIndex:0 });
      };

      let tl: gsap.core.Timeline;

      /* GLITCH SPLIT */
      if (id === 'glitch') {
        const gR    = card.querySelector<HTMLElement>('.ts-glitch-r')!;
        const gB    = card.querySelector<HTMLElement>('.ts-glitch-b')!;
        const flash = card.querySelector<HTMLElement>('.ts-flash')!;
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true, onRepeat:resetPages });
        tl
          .set([gR,gB], { opacity:0 })
          .to(gR, { opacity:.6, x:5,  duration:.06, ease:'none' })
          .to(gB, { opacity:.6, x:-5, duration:.06, ease:'none' }, '<')
          .to([gR,gB], { opacity:0, x:0, duration:.05 })
          .to(gR, { opacity:.85, x:9,  duration:.04, ease:'none' }, '+=.04')
          .to(gB, { opacity:.85, x:-9, duration:.04, ease:'none' }, '<')
          .to(pageA, { y:-5, duration:.04 }, '<')
          .to([gR,gB], { opacity:0, x:0, duration:.03 })
          .to(pageA, { y:0, duration:.03 }, '<')
          .to(flash, { opacity:1, duration:.05, ease:'none' })
          .set(pageA, { zIndex:0 }).set(pageB, { zIndex:2 })
          .to(flash, { opacity:0, duration:.12, ease:'power2.out' })
          .to({}, { duration:1 })
          .set(pageA, { zIndex:1 }).set(pageB, { zIndex:0 });
      }

      /* SCANLINE CURTAIN */
      else if (id === 'scanline') {
        const line = card.querySelector<HTMLElement>('.ts-scanline-bar')!;
        gsap.set(line, { top:'-3px' });
        gsap.set(pageB, { clipPath:'inset(0 0 100% 0)', zIndex:2 });
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set(line, { top:'-3px' });
            gsap.set(pageA, { zIndex:1 });
            gsap.set(pageB, { clipPath:'inset(0 0 100% 0)', zIndex:2 });
          }
        });
        tl
          .to(line,  { top:'102%', duration:.22, ease:'none' })
          .to(pageB, { clipPath:'inset(0 0 0% 0)', duration:.22, ease:'none' }, '<')
          .to({}, { duration:1 })
          .set(pageA, { zIndex:0 }).set(pageB, { clipPath:'none', zIndex:1 });
      }

      /* VERTICAL WIPE */
      else if (id === 'wipe') {
        const wL = card.querySelector<HTMLElement>('.ts-wipe-l')!;
        const wR = card.querySelector<HTMLElement>('.ts-wipe-r')!;
        gsap.set([wL,wR], { width:'0%' });
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set([wL,wR], { width:'0%' });
            gsap.set(pageA, { zIndex:1 });
            gsap.set(pageB, { zIndex:0 });
          }
        });
        tl
          .to([wL,wR], { width:'50.5%', duration:.22, ease:'power2.inOut' })
          .set(pageA, { zIndex:0 }).set(pageB, { zIndex:1 })
          .to([wL,wR], { width:'0%', duration:.22, ease:'power2.inOut' })
          .to({}, { duration:1 });
      }

      /* TERMINAL FLASH */
      else if (id === 'flash') {
        const overlay = card.querySelector<HTMLElement>('.ts-flash-overlay')!;
        const text    = card.querySelector<HTMLElement>('.ts-flash-text')!;
        const LABEL   = '> NAVIGATING MODULE...';
        gsap.set(overlay, { opacity:0 });
        gsap.set(text, { textContent:'' });
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set(overlay, { opacity:0 });
            gsap.set(text, { textContent:'' });
            gsap.set(pageA, { zIndex:1 });
            gsap.set(pageB, { zIndex:0 });
          }
        });
        tl.to(overlay, { opacity:1, duration:.04, ease:'none' });
        LABEL.split('').forEach((_, i) => {
          tl.add(() => { text.textContent = LABEL.slice(0, i + 1); }, `+=${.018}`);
        });
        tl
          .to({}, { duration:.18 })
          .set(pageA, { zIndex:0 }).set(pageB, { zIndex:2 })
          .to(overlay, { opacity:0, duration:.1, ease:'power2.out' })
          .to({}, { duration:1 });
      }

      /* BLOCK DISSOLVE */
      else if (id === 'dissolve') {
        const cells  = card.querySelectorAll<HTMLElement>('.ts-dissolve-cell');
        const cols   = 10;
        const sorted = Array.from(cells).sort((a, b) => {
          const ai = Number(a.dataset.cell), bi = Number(b.dataset.cell);
          return ((ai % cols) + Math.floor(ai / cols)) - ((bi % cols) + Math.floor(bi / cols));
        });
        gsap.set(cells, { opacity:1 });
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set(cells, { opacity:1 });
            gsap.set(pageA, { zIndex:1 });
            gsap.set(pageB, { zIndex:0 });
          }
        });
        tl
          .set(pageB, { zIndex:2 })
          .to(sorted, { opacity:0, duration:.06, stagger:{ each:.025, from:'start' }, ease:'none' })
          .to({}, { duration:1 })
          .to(sorted, { opacity:1, duration:.04, stagger:{ each:.018, from:'end' }, ease:'none' })
          .set(pageA, { zIndex:0 });
      }

      /* CRT POWER-OFF */
      else if (id === 'crt') {
        const line = card.querySelector<HTMLElement>('.ts-crt-line')!;
        gsap.set(line, { opacity:0 });
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set(line, { opacity:0 });
            gsap.set(pageA, { scaleY:1, opacity:1, zIndex:1, transformOrigin:'center center' });
            gsap.set(pageB, { scaleY:1, opacity:1, zIndex:0, transformOrigin:'center center' });
          }
        });
        tl
          .to(pageA, { scaleY:0, duration:.18, ease:'power3.in', transformOrigin:'center center' })
          .to(line,  { opacity:1, duration:.05 }, '-=.04')
          .to({}, { duration:.08 })
          .set(pageA, { zIndex:0 })
          .set(pageB, { scaleY:0, zIndex:2, transformOrigin:'center center' })
          .to(line,  { opacity:0, duration:.06 })
          .to(pageB, { scaleY:1, duration:.2, ease:'power2.out', transformOrigin:'center center' })
          .to({}, { duration:1 });
      }

      /* VENETIAN BLIND */
      else if (id === 'venetian') {
        const strips = card.querySelectorAll<HTMLElement>('.ts-vstrip');
        const even   = Array.from(strips).filter((_, i) => i % 2 === 0);
        const odd    = Array.from(strips).filter((_, i) => i % 2 === 1);
        gsap.set(even, { x:'-100%' });
        gsap.set(odd,  { x:'100%' });
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set(even, { x:'-100%' });
            gsap.set(odd,  { x:'100%' });
            gsap.set(pageA, { zIndex:1 });
            gsap.set(pageB, { zIndex:0 });
          }
        });
        tl
          .to(even, { x:'0%', duration:.22, ease:'power2.inOut' })
          .to(odd,  { x:'0%', duration:.22, ease:'power2.inOut' }, '<')
          .set(pageA, { zIndex:0 }).set(pageB, { zIndex:1 })
          .to({}, { duration:.08 })
          .to(even, { x:'-100%', duration:.22, ease:'power2.inOut' })
          .to(odd,  { x:'100%',  duration:.22, ease:'power2.inOut' }, '<')
          .to({}, { duration:1 });
      }

      /* RADIAL IRIS */
      else if (id === 'iris') {
        gsap.set(pageA, { clipPath:'circle(150% at 50% 50%)' });
        gsap.set(pageB, { zIndex:0 });
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set(pageA, { clipPath:'circle(150% at 50% 50%)', zIndex:1 });
            gsap.set(pageB, { clipPath:'circle(150% at 50% 50%)', zIndex:0 });
          }
        });
        tl
          .to(pageA, { clipPath:'circle(0% at 50% 50%)', duration:.28, ease:'power2.inOut' })
          .set(pageA, { zIndex:0 })
          .set(pageB, { clipPath:'circle(0% at 50% 50%)', zIndex:2 })
          .to(pageB, { clipPath:'circle(150% at 50% 50%)', duration:.28, ease:'power2.out' })
          .to({}, { duration:1 });
      }

      /* SIGNAL DROPOUT */
      else if (id === 'static') {
        const overlay = card.querySelector<HTMLElement>('.ts-static-overlay')!;
        const canvas  = card.querySelector<HTMLCanvasElement>('.ts-static-canvas')!;
        const ctx     = canvas.getContext('2d')!;
        let rafId     = 0;

        function drawNoise() {
          const w = canvas.width, h = canvas.height;
          const img = ctx.createImageData(w, h);
          for (let i = 0; i < img.data.length; i += 4) {
            const v = Math.random() * 255 | 0;
            img.data[i] = img.data[i+1] = img.data[i+2] = v;
            img.data[i+3] = 200;
          }
          ctx.putImageData(img, 0, 0);
          rafId = requestAnimationFrame(drawNoise);
        }

        gsap.set(overlay, { opacity:0 });
        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set(overlay, { opacity:0 });
            gsap.set(pageA, { zIndex:1 });
            gsap.set(pageB, { zIndex:0 });
          }
        });
        tl
          .add(() => drawNoise())
          .to(overlay, { opacity:1, duration:.06, ease:'none' })
          .set(pageA, { zIndex:0 }).set(pageB, { zIndex:1 })
          .to({}, { duration:.18 })
          .to(overlay, { opacity:0, duration:.14, ease:'power1.out' })
          .add(() => { cancelAnimationFrame(rafId); })
          .to({}, { duration:1 });
      }

      /* DISSOLVE + BOOT + HEX */
      else if (id === 'combo') {
        const bootOverlay = card.querySelector<HTMLElement>('.ts-combo-boot')!;
        const bootLines   = card.querySelectorAll<HTMLElement>('.ts-boot-line');
        const cbCells     = card.querySelectorAll<HTMLElement>('.ts-cb-cell');
        const hexCells    = card.querySelectorAll<HTMLElement>('.ts-hex-cell');

        const hexCols = 8, hexRows = 5;

        // Position BOTH grids identically - offset-row hex layout
        [cbCells, hexCells].forEach(group => {
          group.forEach((cell, idx) => {
            const col     = idx % hexCols;
            const row     = Math.floor(idx / hexCols);
            const leftPct = (col / hexCols) * 100 + (row % 2 === 1 ? 50 / hexCols : 0);
            const topPct  = (row / hexRows) * 100;
            (cell as HTMLElement).style.left   = `${leftPct}%`;
            (cell as HTMLElement).style.top    = `${topPct}%`;
            (cell as HTMLElement).style.width  = `${100 / hexCols + 1}%`;
            (cell as HTMLElement).style.height = `${100 / hexRows + 1}%`;
          });
        });

        // Sort dissolve-out cells: diagonal wave top-left → bottom-right
        const cbSorted = Array.from(cbCells).sort((a, b) => {
          const ai = Number(a.dataset.cbcell), bi = Number(b.dataset.cbcell);
          const aWave = (ai % hexCols) + Math.floor(ai / hexCols);
          const bWave = (bi % hexCols) + Math.floor(bi / hexCols);
          return aWave - bWave;
        });

        // Sort reveal cells: radial wave from center outward
        const cx = (hexCols - 1) / 2, cy = (hexRows - 1) / 2;
        const hexSorted = Array.from(hexCells).sort((a, b) => {
          const ai = Number(a.dataset.hcell), bi = Number(b.dataset.hcell);
          const aDist = Math.hypot((ai % hexCols) - cx, Math.floor(ai / hexCols) - cy);
          const bDist = Math.hypot((bi % hexCols) - cx, Math.floor(bi / hexCols) - cy);
          return aDist - bDist;
        });

        // Initial state
        gsap.set(pageA, { zIndex: 2, opacity: 1 });
        gsap.set(pageB, { zIndex: 0, opacity: 1 });
        gsap.set(bootOverlay, { zIndex: 5 });
        gsap.set(bootLines, { opacity: 0 });
        gsap.set(cbCells,   { opacity: 1, zIndex: 6 });
        gsap.set(hexCells,  { opacity: 1, zIndex: 10 });

        tl = gsap.timeline({ repeat:-1, repeatDelay:1.4, paused:true,
          onRepeat() {
            gsap.set(pageA, { zIndex:2, opacity:1 });
            gsap.set(pageB, { zIndex:0, opacity:1 });
            gsap.set(bootLines, { opacity:0 });
            gsap.set(cbCells, { opacity:1 });
            gsap.set(hexCells, { opacity:1 });
            gsap.set(bootOverlay, { opacity:1 });
          }
        });

        // ① Block dissolve out (reveals boot overlay beneath)
        tl.to(cbSorted, {
          opacity: 0,
          duration: .038,
          stagger: { each: .015, from: 'start' },
          ease: 'none',
        });

        // ② Boot lines appear rapidly (overlapping with the dissolve tail)
        Array.from(bootLines).forEach((line, i) => {
          tl.to(line, { opacity: 1, duration: .02, ease: 'none' }, 0.084 + i * 0.063);
        });

        // ③ Brief hold - all boot text visible
        tl.to({}, { duration: .13 });

        // ④ Page B rises above the boot overlay, hex cells already cover it
        tl.set(pageB, { zIndex: 9 });

        // ⑤ Hex cells blink out from center → Page B revealed
        tl.to(hexSorted, {
          opacity: 0,
          duration: .035,
          stagger: { each: .013, from: 'start' },
          ease: 'none',
        });

        // ⑥ Boot overlay fades as hex cells open (it's behind Page B anyway)
        tl.to(bootOverlay, { opacity: 0, duration: .084 }, '-=.175');

        // Hold on Page B
        tl.to({}, { duration: .7 });

        // Reset for next loop
        tl.set(pageA, { zIndex: 2 }).set(pageB, { zIndex: 0 });
      }

      if (!tl!) return;
      tl.play();
      prev.addEventListener('mouseenter', () => tl.pause());
      prev.addEventListener('mouseleave', () => tl.play());
    });
  }

  document.addEventListener('astro:page-load', buildTimelines);
</script>
