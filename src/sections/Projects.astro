---
import content from '../content/index.js';
const { projects } = content;
const projectItems = projects.items ?? [];
---

<section id="projects" class="py-section-padding px-margin-mobile md:px-margin-desktop">
  <div class="w-full max-w-container-max mx-auto">

    <!-- Header -->
    <header class="proj-header mb-16">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">{projects.sectionLabel}</span>
      </div>
      <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-4">
        <span class="text-secondary">//</span> <span>{projects.sectionTitle}</span>
      </h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">{projects.sectionSubtitle}</p>
    </header>

    <!-- Case studies -->
    <div class="flex flex-col">
      {projectItems.map((p, i) => (
        <article class="proj-row grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-center py-14 md:py-20 border-b border-outline-variant/10 last:border-0">

          <!-- Screenshot / placeholder -->
          <div class={`md:col-span-7 ${i % 2 === 1 ? 'md:order-2' : ''}`}>
            <div class="rounded-xl overflow-hidden border border-outline-variant/20 shadow-2xl bg-surface-container-lowest">
              <div class="flex items-center gap-1.5 px-4 py-3 bg-[#111214]">
                <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f]"></span>
              </div>
              {p.image ? (
                <img src={p.image} alt={p.imageAlt} loading="lazy" class="w-full h-auto block" />
              ) : (
                <div class="aspect-[16/10] flex flex-col items-center justify-center gap-3 bg-surface-container text-on-surface-variant">
                  <span class="material-symbols-outlined text-4xl opacity-40">lock</span>
                  <p class="font-code-snippet text-code-snippet text-xs opacity-60 text-center px-6">Internal tool - NDA, no public link</p>
                </div>
              )}
            </div>
          </div>

          <!-- Copy -->
          <div class={`md:col-span-5 ${i % 2 === 1 ? 'md:order-1' : ''}`}>
            <span class="font-code-snippet text-code-snippet text-secondary">0{i + 1} //</span>
            <h3 class="font-headline-md text-headline-md text-primary mt-2 mb-3">{p.name}</h3>

            <div class="flex gap-2 flex-wrap mb-6">
              {(p.chips ?? []).slice(0, 3).map(t => (
                <span class="chip font-label-sm text-label-sm px-3 py-1 text-on-surface-variant rounded">{t}</span>
              ))}
            </div>

            <p class="font-body-md text-body-md text-on-surface-variant mb-6">{p.description}</p>

            <div class="mt-6 pt-6 border-t border-outline-variant/20 flex items-center justify-between gap-4">
              <span class="font-code-snippet text-code-snippet text-outline">{p.category}</span>
              {p.href ? (
                <a href={p.href} target="_blank" rel="noopener noreferrer" class="font-code-snippet text-code-snippet text-secondary hover:text-primary transition-colors flex items-center gap-1 whitespace-nowrap">
                  VIEW_LIVE <span class="material-symbols-outlined text-sm">arrow_forward</span>
                </a>
              ) : (
                <span class="font-code-snippet text-code-snippet text-outline whitespace-nowrap">NDA - no link</span>
              )}
            </div>
          </div>

        </article>
      ))}
    </div>

    <!-- View all -->
    <div class="proj-cta flex justify-center mt-16">
      <a
        href="/projects"
        class="px-8 py-4 border border-primary/30 text-primary font-code-snippet text-code-snippet rounded hover:bg-primary/10 hover:border-primary/50 transition-colors flex items-center gap-2"
      >
        VIEW_ALL_PROJECTS <span class="material-symbols-outlined text-sm">arrow_forward</span>
      </a>
    </div>

  </div>
</section>

<style>
  #projects .proj-header,
  #projects .proj-row,
  #projects .proj-cta {
    opacity: 0;
    transform: translateY(24px);
  }
</style>

<script>
  import { fadeUp } from '../scripts/animations.js';

  // astro:page-load (not top-level) - Astro's client-side nav only executes
  // this module once ever; without re-binding here, returning to this page
  // leaves the fresh DOM stuck at its CSS opacity:0 starting state.
  document.addEventListener('astro:page-load', () => {
    fadeUp('#projects .proj-header', '#projects');

    // Each row reveals independently as it scrolls into view - a single
    // trigger on the section would fire every row (even ones far below
    // the fold) as soon as the header appears.
    document.querySelectorAll('#projects .proj-row, #projects .proj-cta').forEach(row => {
      fadeUp(row as HTMLElement, row as HTMLElement, { start: 'top 90%' });
    });
  });
</script>
