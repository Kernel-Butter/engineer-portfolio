---
import BlobCard from '../components/BlobCard.astro';

const bars = Array.from({ length: 32 }, () => ({
  height: Math.floor(Math.random() * 60 + 10),
  opacity: (Math.random() * 0.6 + 0.2).toFixed(2),
}));
const dotColors = ['#c0c1ff', '#44e2cd', '#4edea3'];
---

<section id="projects" class="py-section-padding px-margin-mobile md:px-margin-desktop">
  <div class="w-full max-w-container-max mx-auto">

    <!-- Header -->
    <header class="proj-header mb-16">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">// CASE_STUDIES</span>
      </div>
      <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface mb-4">
        <span class="text-secondary">//</span> Featured Projects
      </h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
        High-performance architectural solutions and technical case studies. Focusing on rendering optimization, edge infrastructure, and complex data parsing.
      </p>
    </header>

    <!-- Bento grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-bento-gap">

      <!-- Project 1: Quantum Dashboard — 8 cols (indigo) -->
      <BlobCard
        tag="article"
        class="proj-card bento-card rounded-xl md:col-span-8 flex flex-col p-8 group relative"
        pattern="grid"
        blobs={[
          { color: 'bg-indigo-500/25', position: '-top-20 -left-16', size: 'w-80 h-80', blur: 'blur-[90px]', anim: 'a', dur: '14s' },
          { color: 'bg-indigo-400/15', position: 'bottom-0 right-4',  size: 'w-52 h-52', blur: 'blur-[65px]', anim: 'b', dur: '9s', delay: '-4s' },
        ]}
      >
        <div class="flex justify-between items-start mb-6">
          <div>
            <h3 class="font-headline-md text-headline-md text-primary mb-2">Quantum Dashboard</h3>
            <div class="flex gap-2 flex-wrap">
              <span class="chip font-label-sm text-label-sm px-3 py-1 text-on-surface rounded flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span> Live
              </span>
              <span class="chip font-label-sm text-label-sm px-3 py-1 text-on-surface-variant rounded">WebGL</span>
              <span class="chip font-label-sm text-label-sm px-3 py-1 text-on-surface-variant rounded">Data Viz</span>
            </div>
          </div>
          <span class="material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors text-3xl">query_stats</span>
        </div>

        <!-- Decorative data-viz -->
        <div class="relative w-full h-56 bg-[#050505] rounded-lg mb-6 overflow-hidden border border-white/5">
          <div class="proj-viz absolute inset-0 opacity-60"></div>
          <div class="absolute top-4 left-4 flex gap-2">
            {dotColors.map(c => (
              <div class="w-2 h-2 rounded-full animate-pulse" style={`background:${c}`}></div>
            ))}
          </div>
          <div class="absolute inset-x-6 bottom-6 flex items-end gap-1">
            {bars.map(b => (
              <div
                class="flex-1 rounded-sm bg-primary min-w-0"
                style={`height:${b.height}px;opacity:${b.opacity}`}
              ></div>
            ))}
          </div>
          <div class="absolute bottom-0 inset-x-0 h-12 bg-gradient-to-t from-[#050505] to-transparent"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-auto">
          <div>
            <h4 class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mb-2">Problem</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">Severe rendering lag during real-time ingestion of complex node graphs.</p>
          </div>
          <div>
            <h4 class="font-label-sm text-label-sm text-tertiary uppercase tracking-widest mb-2">Approach</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">Custom WebGL shaders offloading matrix calculations to GPU.</p>
          </div>
          <div>
            <h4 class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2">Result</h4>
            <p class="font-headline-md text-headline-md text-on-surface font-bold">
              60fps <span class="font-body-md text-body-md text-on-surface-variant font-normal">@ 100k nodes</span>
            </p>
          </div>
        </div>
      </BlobCard>

      <!-- Project 2: Aurelius Commerce — 4 cols (teal) -->
      <BlobCard
        tag="article"
        class="proj-card bento-card rounded-xl md:col-span-4 flex flex-col p-8 group relative"
        pattern="lines"
        blobs={[
          { color: 'bg-teal-500/25', position: '-top-10 -right-10', size: 'w-56 h-56', blur: 'blur-[70px]', anim: 'b', dur: '11s' },
          { color: 'bg-teal-400/15', position: 'bottom-0 left-0',   size: 'w-40 h-40', blur: 'blur-[50px]', anim: 'c', dur: '8s', delay: '-3s' },
        ]}
      >
        <div class="flex justify-between items-start mb-6">
          <div>
            <h3 class="font-headline-md text-headline-md text-primary mb-2">Aurelius Commerce</h3>
            <div class="flex gap-2 flex-wrap">
              <span class="chip font-label-sm text-label-sm px-3 py-1 text-on-surface-variant rounded">Next.js</span>
              <span class="chip font-label-sm text-label-sm px-3 py-1 text-on-surface-variant rounded">Edge</span>
            </div>
          </div>
          <span class="material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors text-3xl">shopping_cart</span>
        </div>

        <div class="flex-grow flex flex-col justify-center gap-6 py-4">
          <div>
            <h4 class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mb-2">Problem</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">Poor SEO and slow TTFB on a high-end headless storefront.</p>
          </div>
          <div>
            <h4 class="font-label-sm text-label-sm text-tertiary uppercase tracking-widest mb-2">Approach</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">Re-architected routing using Next.js App Router with globally distributed Edge caching.</p>
          </div>
        </div>

        <div class="mt-auto pt-6 border-t border-outline-variant/20">
          <h4 class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-2">Lighthouse Score</h4>
          <span class="font-headline-lg-mobile text-headline-lg-mobile text-secondary font-bold">98/100</span>
        </div>
      </BlobCard>

      <!-- Project 3: Synthetix AI — full width (violet) -->
      <BlobCard
        tag="article"
        class="proj-card bento-card rounded-xl md:col-span-12 flex flex-col md:flex-row p-8 group gap-8 relative"
        pattern="dots"
        blobs={[
          { color: 'bg-violet-500/20', position: '-top-16 left-8',  size: 'w-80 h-80', blur: 'blur-[90px]', anim: 'c', dur: '15s' },
          { color: 'bg-violet-400/15', position: 'top-8 right-16', size: 'w-72 h-72', blur: 'blur-[80px]', anim: 'a', dur: '11s', delay: '-7s' },
        ]}
      >
        <div class="w-full md:w-1/3 flex flex-col">
          <div class="mb-4">
            <h3 class="font-headline-md text-headline-md text-primary mb-2">Synthetix AI</h3>
            <div class="flex gap-2">
              <span class="chip font-label-sm text-label-sm px-3 py-1 text-on-surface-variant rounded">AST</span>
              <span class="chip font-label-sm text-label-sm px-3 py-1 text-on-surface-variant rounded">Parsers</span>
            </div>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant mb-6">
            A design-to-code pipeline automating UI handoff from Figma to production React.
          </p>
          <div class="mt-auto flex flex-col gap-4">
            <div>
              <h4 class="font-label-sm text-label-sm text-secondary uppercase tracking-widest mb-1">Problem</h4>
              <p class="font-body-md text-body-md text-on-surface-variant">Friction and inconsistency in manual implementation from design tokens.</p>
            </div>
            <div>
              <h4 class="font-label-sm text-label-sm text-tertiary uppercase tracking-widest mb-1">Approach</h4>
              <p class="font-body-md text-body-md text-on-surface-variant">Custom AST parsers translating Figma JSON to semantic React + Tailwind components.</p>
            </div>
          </div>
        </div>

        <!-- Code snippet viz -->
        <div class="w-full md:w-2/3 relative rounded-lg overflow-hidden border border-white/5 bg-[#050505] min-h-[280px] flex items-center p-8">
          <pre class="font-code-snippet text-code-snippet text-on-surface-variant/50 overflow-x-auto w-full leading-relaxed"><span class="text-secondary">const</span> <span class="text-primary">parser</span> = new <span class="text-tertiary">ASTNodeParser</span>({'{'}
  target: <span class="text-secondary">'react-tailwind'</span>,
  strictMode: <span class="text-tertiary">true</span>,
{'}'});

<span class="text-secondary">function</span> <span class="text-primary">transformNode</span>(node) {'{'}
  <span class="text-secondary">if</span> (node.type === <span class="text-secondary">'FRAME'</span>) {'{'}
    <span class="text-secondary">return</span> {'{'}
      element: <span class="text-secondary">'div'</span>,
      className: <span class="text-primary">generateTailwind</span>(node.style),
    {'}'};
  {'}'}
{'}'}
<span class="text-outline">// Result: 40% faster shipping.</span></pre>
          <div class="absolute bottom-6 right-6 bg-surface-dim/90 backdrop-blur-sm px-6 py-4 rounded border border-primary/20">
            <h4 class="font-label-sm text-label-sm text-primary uppercase tracking-widest mb-1">Impact</h4>
            <p class="font-headline-md text-headline-md text-on-surface">40% Faster Shipping</p>
          </div>
        </div>
      </BlobCard>

    </div>
  </div>
</section>

<script>
  import { fadeUp, staggerFadeUp } from '../scripts/animations.js';

  fadeUp('#projects .proj-header', '#projects');
  staggerFadeUp('#projects .proj-card', '#projects .grid', { stagger: 0.15, start: 'top 75%' });
</script>
