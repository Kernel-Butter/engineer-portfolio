---
import { fontPairings as pairings, defaultFontPairing, buildGoogleFontsHref } from '../data/fonts.js';

const headlineSample = 'Frontend Engineer, Systems Thinking';
const bodySample = 'I build fast, accessible interfaces and the systems behind them — from motion-heavy marketing sites to data-dense dashboards.';
const codeSample = "const engineer = { role: 'Frontend', focus: 'Systems' };";

// Union of every pairing's Google Fonts params, deduped, so this comparison
// page can render all candidates simultaneously without per-card fetches.
const allFontsHref = buildGoogleFontsHref(
  [...new Set(pairings.flatMap(p => p.googleFonts.split('&')))].join('&')
);
---

<link href={allFontsHref} rel="stylesheet" />

<section class="fc-section py-section-padding px-margin-mobile md:px-margin-desktop">
  <div class="w-full max-w-container-max mx-auto">

    <header class="mb-14">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">// FONT_COMPARE</span>
      </div>
      <h2 id="fc-live-heading" class="font-headline-lg text-headline-lg text-on-surface mb-3">Font Comparison</h2>
      <p id="fc-live-body" class="font-body-md text-body-md text-on-surface-variant max-w-xl">
        Same headline, body copy, and code snippet, rendered in {pairings.length} candidate font pairings. Compare side by side, then apply one to preview it against this page's own heading and body copy.
      </p>
      <p id="fc-active-label" class="font-code-snippet text-[10px] text-on-surface-variant/40 uppercase tracking-widest mt-4">Previewing: {defaultFontPairing.name} (site default)</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {pairings.map(p => (
        <div class:list={['fc-card', { 'fc-active': p.default }]} data-id={p.id} style={`--accent:${p.accent}`}>

          <div class="fc-card-head">
            <span class="fc-pill" style={`color:${p.accent};border-color:${p.accent}40;background:${p.accent}12`}>
              {p.default ? 'Site default' : 'Candidate'}
            </span>
            <span class="fc-name">{p.name}</span>
            <button
              class="fc-apply"
              type="button"
              data-id={p.id}
              data-display={p.displayStack}
              data-body={p.bodyStack}
              data-mono={p.monoStack ?? p.displayStack}
              data-name={p.name}
              style={`--accent:${p.accent}`}
            >Apply</button>
          </div>

          <div class="fc-sample" style={`font-family:${p.displayStack}`}>
            <h3 class="fc-headline">{headlineSample}</h3>
          </div>

          <p class="fc-body" style={`font-family:${p.bodyStack}`}>{bodySample}</p>

          <pre class="fc-code" style={`font-family:${p.monoStack ?? p.displayStack}`}><code>{codeSample}</code></pre>

          <div class="fc-alphabet" style={`font-family:${p.bodyStack}`}>ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789</div>

          <p class="fc-note">{p.note}</p>

        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const heading = document.getElementById('fc-live-heading');
  const body    = document.getElementById('fc-live-body');
  const label   = document.getElementById('fc-active-label');
  const cards   = document.querySelectorAll<HTMLElement>('.fc-card');

  document.querySelectorAll<HTMLButtonElement>('.fc-apply').forEach(btn => {
    btn.addEventListener('click', () => {
      const { display, body: bodyFont, name, id } = btn.dataset;
      if (heading) heading.style.fontFamily = display ?? '';
      if (body)    body.style.fontFamily    = bodyFont ?? '';
      if (label)   label.textContent        = `Previewing: ${name}`;

      cards.forEach(card => card.classList.toggle('fc-active', card.dataset.id === id));
    });
  });
</script>

<style>
  .fc-card {
    display: flex; flex-direction: column; gap: 12px;
    padding: 24px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.08);
    background: #0d0d0d;
    transition: border-color .2s, box-shadow .2s;
  }
  .fc-card.fc-active {
    border-color: color-mix(in srgb, var(--accent, #c0c1ff) 55%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent, #c0c1ff) 25%, transparent);
  }
  .fc-card-head { display: flex; align-items: center; gap: 10px; }
  .fc-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px; text-transform: uppercase; letter-spacing: .16em;
    padding: 3px 8px; border-radius: 999px; border: 1px solid;
  }
  .fc-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; text-transform: uppercase; letter-spacing: .1em;
    color: rgba(255,255,255,.6);
  }
  .fc-apply {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 9.5px; text-transform: uppercase; letter-spacing: .12em;
    padding: 4px 10px; border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--accent, #c0c1ff) 40%, transparent);
    background: color-mix(in srgb, var(--accent, #c0c1ff) 10%, transparent);
    color: var(--accent, #c0c1ff);
    cursor: pointer;
    transition: background .15s, transform .15s;
  }
  .fc-apply:hover  { background: color-mix(in srgb, var(--accent, #c0c1ff) 20%, transparent); }
  .fc-apply:active { transform: scale(.96); }
  .fc-card.fc-active .fc-apply { background: var(--accent, #c0c1ff); color: #0d0d0d; }
  .fc-headline {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.15; letter-spacing: -0.01em; font-weight: 700;
    color: #e5e2e1;
  }
  .fc-body {
    font-size: 15px; line-height: 1.6; color: rgba(229,226,225,.7);
  }
  .fc-code {
    margin: 0; padding: 10px 14px; border-radius: 6px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.06);
    font-size: 12.5px; color: var(--accent, #c0c1ff); overflow-x: auto;
  }
  .fc-alphabet {
    font-size: 12px; letter-spacing: .04em; color: rgba(255,255,255,.35);
  }
  .fc-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; line-height: 1.5; letter-spacing: .02em;
    color: rgba(255,255,255,.3);
    padding-top: 8px; border-top: 1px solid rgba(255,255,255,.06);
  }
</style>
