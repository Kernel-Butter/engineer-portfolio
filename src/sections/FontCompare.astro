---
const pairings = [
  {
    id: 'current', name: 'Current', display: 'JetBrains Mono', body: 'Inter',
    displayStack: "'JetBrains Mono', monospace", bodyStack: "'Inter', sans-serif",
    accent: '#c0c1ff',
    note: 'What the site uses today.',
  },
  {
    id: 'geist', name: 'Geist', display: 'Geist', body: 'Geist',
    displayStack: "'Geist', sans-serif", bodyStack: "'Geist', sans-serif",
    mono: 'Geist Mono', monoStack: "'Geist Mono', monospace",
    accent: '#44e2cd',
    note: "Vercel's typeface — closest structural swap, same roles (sans body, mono code/labels).",
  },
  {
    id: 'plex', name: 'IBM Plex', display: 'IBM Plex Sans', body: 'IBM Plex Sans',
    displayStack: "'IBM Plex Sans', sans-serif", bodyStack: "'IBM Plex Sans', sans-serif",
    mono: 'IBM Plex Mono', monoStack: "'IBM Plex Mono', monospace",
    accent: '#4edea3',
    note: 'A matched family designed to work together end to end.',
  },
  {
    id: 'grotesk', name: 'Space Grotesk + Inter', display: 'Space Grotesk', body: 'Inter',
    displayStack: "'Space Grotesk', sans-serif", bodyStack: "'Inter', sans-serif",
    mono: 'JetBrains Mono', monoStack: "'JetBrains Mono', monospace",
    accent: '#ffc542',
    note: 'Geometric display headline, keeps Inter for body copy.',
  },
  {
    id: 'firacode', name: 'Fira Code + Inter', display: 'Fira Code', body: 'Inter',
    displayStack: "'Fira Code', monospace", bodyStack: "'Inter', sans-serif",
    mono: 'Fira Code', monoStack: "'Fira Code', monospace",
    accent: '#ff7eb3',
    note: 'Keep Inter for everything, swap only the mono for more character.',
  },
];

const headlineSample = 'Frontend Engineer, Systems Thinking';
const bodySample = 'I build fast, accessible interfaces and the systems behind them — from motion-heavy marketing sites to data-dense dashboards.';
const codeSample = "const engineer = { role: 'Frontend', focus: 'Systems' };";
---

<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700;800&family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Fira+Code:wght@400;500;600;700&display=swap"
  rel="stylesheet"
/>

<section class="fc-section py-section-padding px-margin-mobile md:px-margin-desktop">
  <div class="w-full max-w-container-max mx-auto">

    <header class="mb-14">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
        <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">// FONT_COMPARE</span>
      </div>
      <h2 class="font-headline-lg text-headline-lg text-on-surface mb-3">Font Comparison</h2>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
        Same headline, body copy, and code snippet, rendered in {pairings.length} candidate font pairings. Compare side by side before picking one.
      </p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {pairings.map(p => (
        <div class="fc-card" style={`--accent:${p.accent}`}>

          <div class="fc-card-head">
            <span class="fc-pill" style={`color:${p.accent};border-color:${p.accent}40;background:${p.accent}12`}>
              {p.id === 'current' ? 'Current' : 'Candidate'}
            </span>
            <span class="fc-name">{p.name}</span>
          </div>

          <div class="fc-sample" style={`font-family:${p.displayStack}`}>
            <h3 class="fc-headline">{headlineSample}</h3>
          </div>

          <p class="fc-body" style={`font-family:${p.bodyStack}`}>{bodySample}</p>

          <pre class="fc-code" style={`font-family:${p.monoStack ?? p.displayStack}`}><code>{codeSample}</code></pre>

          <div class="fc-alphabet" style={`font-family:${p.bodyStack}`}>ABCDEFGHIJKLMNOPQRSTUVWXYZ 0123456789</div>

          <p class="fc-note">{p.note}</p>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .fc-card {
    display: flex; flex-direction: column; gap: 12px;
    padding: 24px;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,.08);
    background: #0d0d0d;
  }
  .fc-card-head { display: flex; align-items: center; gap: 10px; }
  .fc-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 9px; text-transform: uppercase; letter-spacing: .16em;
    padding: 3px 8px; border-radius: 999px; border: 1px solid;
  }
  .fc-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; text-transform: uppercase; letter-spacing: .1em;
    color: rgba(255,255,255,.6);
  }
  .fc-headline {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.15; letter-spacing: -0.01em; font-weight: 700;
    color: #e5e2e1;
  }
  .fc-body {
    font-size: 15px; line-height: 1.6; color: rgba(229,226,225,.7);
  }
  .fc-code {
    margin: 0; padding: 10px 14px; border-radius: 6px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.06);
    font-size: 12.5px; color: var(--accent, #c0c1ff); overflow-x: auto;
  }
  .fc-alphabet {
    font-size: 12px; letter-spacing: .04em; color: rgba(255,255,255,.35);
  }
  .fc-note {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px; line-height: 1.5; letter-spacing: .02em;
    color: rgba(255,255,255,.3);
    padding-top: 8px; border-top: 1px solid rgba(255,255,255,.06);
  }
</style>
