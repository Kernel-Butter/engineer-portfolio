---
import BlobCard from '../components/BlobCard.astro';
import content from '../content/index.js';
const { contact } = content;
const show = { status: true, headline: true, introduction: true, hint: true, socials: true, booking: true, contactForm: true, ...contact.visibility };

const socials = [
  { label: 'GitHub',   icon: 'code', hoverColor: 'hover:text-primary', href: contact.githubHref },
  { label: 'LinkedIn', icon: 'work', hoverColor: 'hover:text-secondary', href: contact.linkedinHref },
];
---

<section id="contact" class="py-section-padding px-margin-mobile md:px-margin-desktop relative overflow-hidden">

  <!-- Background glows -->
  <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/4 right-1/4 w-[400px] h-[400px] bg-secondary/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

  <div class="w-full max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-12 gap-bento-gap items-stretch">

    <!-- Left - Headline & links (5 cols) -->
    <div class="ct-left md:col-span-5 flex flex-col justify-center gap-8 pr-0 md:pr-12">

      <div class="flex flex-col gap-4">
        <!-- Status badge -->
        {show.status && <span class="inline-flex items-center gap-2 self-start px-3 py-1 rounded bg-[#171717] text-tertiary font-label-sm text-label-sm border border-tertiary/20 shadow-[0_0_10px_rgba(78,222,163,0.1)]">
          <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
          <span>{contact.statusBadge}</span>
        </span>}

        {show.headline && <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-primary tracking-tighter uppercase drop-shadow-[0_0_15px_rgba(192,193,255,0.2)]">
          <span>{contact.headlineLine1}</span><br />
          <span>{contact.headlineLine2}</span>
        </h2>}

        {show.introduction && <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md">{contact.subheadline}</p>}
      </div>

      <!-- Divider hint -->
      {show.hint && <div class="border-t border-outline-variant/20 pt-8 space-y-4 font-code-snippet text-code-snippet text-outline">
        <p class="flex items-center gap-3">
          <span class="material-symbols-outlined text-secondary" style="font-variation-settings:'FILL' 1">terminal</span>
          <span class="text-on-surface-variant">{contact.hint}</span>
        </p>
      </div>}

      <!-- Social links -->
      {show.socials && <div class="flex gap-4">
        {socials.map(s => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class={`w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-on-surface-variant ${s.hoverColor} hover:bg-surface-container-high transition-colors border border-outline-variant/30`}
          >
            <span class="material-symbols-outlined" style="font-variation-settings:'FILL' 0">{s.icon}</span>
          </a>
        ))}
      </div>}
    </div>

    <!-- Right - Booking + form (7 cols) -->
    <div class="ct-right md:col-span-7 flex flex-col gap-bento-gap">

      <!-- Book a call card -->
      {show.booking && <BlobCard
        class="ct-card bento-card rounded-xl p-8 flex flex-col md:flex-row items-center justify-between gap-6 group relative overflow-hidden"
        blobs={[
          { color: 'bg-indigo-500/20', position: '-top-8 -left-8',  size: 'w-64 h-64', blur: 'blur-[75px]', anim: 'a', dur: '13s' },
          { color: 'bg-indigo-400/15', position: 'bottom-0 right-0', size: 'w-44 h-44', blur: 'blur-[55px]', anim: 'b', dur: '9s', delay: '-4s' },
        ]}
      >
        <div class="absolute inset-0 bg-gradient-to-r from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <div class="relative z-10 text-center md:text-left">
          <h3 class="font-headline-md text-headline-md text-on-surface mb-2">{contact.bookCallTitle}</h3>
          <p class="font-code-snippet text-code-snippet text-outline">{contact.bookCallSubtitle}</p>
        </div>
        <a
          id="schedule-btn"
          href={contact.bookCallHref}
          class="ct-magnetic relative z-10 w-full md:w-auto px-8 py-4 bg-primary text-on-primary font-headline-md text-headline-md font-bold rounded-lg hover:shadow-[0_0_20px_rgba(192,193,255,0.4)] flex items-center justify-center gap-2 whitespace-nowrap overflow-hidden transition-shadow duration-300"
        >
          <span class="material-symbols-outlined">calendar_month</span>
          SCHEDULE CALL
          <!-- Ripple layer -->
          <span class="absolute inset-0 pointer-events-none"
                style="background:radial-gradient(circle,rgba(68,226,205,0.2) 0%,transparent 70%);transform:scale(0);transition:transform 0.5s ease"
                id="schedule-ripple"></span>
        </a>
      </BlobCard>}

      <!-- Contact form card -->
      {show.contactForm && <div class="ct-card bento-card rounded-xl p-8 flex-grow">
        <h3 class="font-headline-md text-headline-md text-on-surface mb-6 flex items-center gap-2">
          <span class="material-symbols-outlined text-tertiary">mail</span>
          <span>{contact.formTitle}</span>
        </h3>

        <form id="contact-form" class="space-y-6" novalidate>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="font-label-sm text-label-sm text-outline uppercase block" for="ct-name">Initiator</label>
              <input
                id="ct-name" name="name" type="text"
                placeholder="YOUR NAME"
                class="ct-input w-full px-4 py-3 rounded-md font-code-snippet text-code-snippet text-on-surface placeholder:text-outline-variant"
              />
            </div>
            <div class="space-y-2">
              <label class="font-label-sm text-label-sm text-outline uppercase block" for="ct-email">Return Address</label>
              <input
                id="ct-email" name="email" type="email"
                placeholder="YOUR@EMAIL.COM"
                class="ct-input w-full px-4 py-3 rounded-md font-code-snippet text-code-snippet text-on-surface placeholder:text-outline-variant"
              />
            </div>
          </div>

          <div class="space-y-2">
            <label class="font-label-sm text-label-sm text-outline uppercase block" for="ct-message">Payload</label>
            <textarea
              id="ct-message" name="message" rows="4"
              placeholder="DESCRIBE THE SCOPE..."
              class="ct-input w-full px-4 py-3 rounded-md font-code-snippet text-code-snippet text-on-surface placeholder:text-outline-variant resize-none"
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-outline-variant/10">
            <span id="ct-status" class="font-code-snippet text-code-snippet text-outline text-xs opacity-0 transition-opacity duration-300"></span>
            <button
              type="submit"
              class="px-6 py-3 border border-secondary text-secondary font-code-snippet text-code-snippet rounded hover:bg-secondary/10 transition-colors flex items-center gap-2 group/btn"
            >
              EXECUTE_SEND
              <span class="material-symbols-outlined text-sm group-hover/btn:translate-x-1 transition-transform">arrow_forward</span>
            </button>
          </div>

        </form>
      </div>}

    </div>
  </div>
</section>

<script>
  import { fadeUp, staggerFadeUp, magneticButton, rippleHover, clickBurst } from '../scripts/animations.js';

  // astro:page-load (not top-level) - Astro's client-side nav only executes
  // this module once ever; without re-binding here, returning to this page
  // leaves the fresh DOM stuck at its CSS opacity:0 starting state, and the
  // button/form listeners below would still be bound to elements from the
  // very first visit instead of the fresh ones.
  document.addEventListener('astro:page-load', () => {
    fadeUp('#contact .ct-left',  '#contact', { start: 'top 78%' });
    staggerFadeUp('#contact .ct-card', '#contact .grid', { stagger: 0.15, start: 'top 75%' });

    const btn    = document.getElementById('schedule-btn');
    const ripple = document.getElementById('schedule-ripple');
    if (btn && ripple) {
      magneticButton(btn);
      rippleHover(btn, ripple);
      clickBurst(btn);
    }

    // Form submit (hook up to EmailJS / backend later)
    const form   = document.getElementById('contact-form');
    const status = document.getElementById('ct-status');
    form?.addEventListener('submit', e => {
      e.preventDefault();
      if (!status) return;
      status.textContent = '> TRANSMISSION QUEUED...';
      status.style.opacity = '1';
      status.classList.replace('text-outline', 'text-tertiary');
      // Simulated success - replace with real send logic
      setTimeout(() => {
        status.textContent = '> SIGNAL RECEIVED. WILL RESPOND WITHIN 24H.';
        status.classList.replace('text-tertiary', 'text-secondary');
        (form as HTMLFormElement).reset();
      }, 1200);
    });
  });
</script>
