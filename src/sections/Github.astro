---
const GH_USER = 'Kernel-Butter';

type GhUser = { public_repos: number; followers: number };
type GhRepo = {
  name: string; description: string | null; language: string | null;
  stargazers_count: number; forks_count: number; fork: boolean; html_url: string;
};

const langColors: Record<string, { text: string; dot: string }> = {
  TypeScript: { text: 'text-primary',   dot: 'bg-primary' },
  JavaScript: { text: 'text-secondary', dot: 'bg-secondary' },
  Astro:      { text: 'text-tertiary',  dot: 'bg-tertiary' },
  HTML:       { text: 'text-secondary', dot: 'bg-secondary' },
  CSS:        { text: 'text-primary',   dot: 'bg-primary' },
};
const defaultLangColor = { text: 'text-on-surface-variant', dot: 'bg-outline' };

let user: GhUser | null = null;
let repos: GhRepo[] = [];
let fetchFailed = false;

try {
  const [userRes, reposRes] = await Promise.all([
    fetch(`https://api.github.com/users/${GH_USER}`, { signal: AbortSignal.timeout(5000) }),
    fetch(`https://api.github.com/users/${GH_USER}/repos?per_page=100`, { signal: AbortSignal.timeout(5000) }),
  ]);
  if (!userRes.ok || !reposRes.ok) throw new Error('GitHub API request failed');
  user = await userRes.json();
  repos = await reposRes.json();
} catch {
  fetchFailed = true;
}

const ownRepos     = repos.filter(r => !r.fork);
const starsEarned  = ownRepos.reduce((sum, r) => sum + r.stargazers_count, 0);
const featuredRepos = [...ownRepos]
  .sort((a, b) => b.stargazers_count - a.stargazers_count)
  .slice(0, 3);

const metrics = [
  { label: 'PUBLIC_REPOS', value: user ? String(user.public_repos) : '—', accent: false },
  { label: 'FOLLOWERS',    value: user ? String(user.followers)    : '—', accent: false },
  { label: 'STARS_EARNED', value: user ? String(starsEarned)       : '—', accent: true  },
];
---

<section id="github" class="py-section-padding px-margin-mobile md:px-margin-desktop">
  <div class="w-full max-w-container-max mx-auto flex flex-col gap-bento-gap">

    <!-- Header -->
    <header class="gh-header mb-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
        <span class="font-label-sm text-label-sm text-primary uppercase tracking-widest">Status: Actively Contributing</span>
      </div>
      <h2 class="font-headline-lg-mobile md:font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">
        Open Source Pulse
      </h2>
      <p class="font-body-md text-body-md text-on-surface-variant mt-4 max-w-2xl">
        Live data pulled from <a href={`https://github.com/${GH_USER}`} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">github.com/{GH_USER}</a> at build time.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-bento-gap">

      <!-- Heatmap — 8 cols -->
      <div class="gh-card bento-card rounded-xl p-8 md:col-span-8 flex flex-col justify-between min-h-[300px]">
        <div class="flex justify-between items-start mb-6">
          <h3 class="font-headline-md text-headline-md text-primary">Contribution Grid</h3>
          <span class="material-symbols-outlined text-outline-variant">grid_on</span>
        </div>

        <div class="flex-grow flex items-center justify-center relative overflow-hidden">
          <img
            src={`https://ghchart.rshah.org/c0c1ff/${GH_USER}`}
            alt={`${GH_USER} GitHub contribution graph`}
            class="w-full h-auto opacity-90"
            loading="lazy"
          />
        </div>

        <div class="flex justify-center items-center mt-6 font-code-snippet text-code-snippet text-on-surface-variant text-xs">
          <span>Past 12 months</span>
        </div>
      </div>

      <!-- Metrics — 4 cols -->
      <div class="gh-card bento-card rounded-xl p-8 md:col-span-4 flex flex-col gap-6">
        <h3 class="font-headline-md text-headline-md text-secondary">System Metrics</h3>
        <div class="flex flex-col gap-4">
          {metrics.map((m, i) => (
            <div class={i < metrics.length - 1 ? 'border-b border-outline-variant/20 pb-4' : ''}>
              <span class="font-label-sm text-label-sm text-on-surface-variant block mb-1">{m.label}</span>
              <div class={`font-headline-lg-mobile text-headline-lg-mobile gh-metric ${m.accent ? 'text-primary' : 'text-on-surface'}`}>
                {m.value}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Featured repos — 12 cols -->
      <div class="gh-card bento-card rounded-xl p-8 md:col-span-12">
        <div class="flex justify-between items-center mb-6 border-b border-outline-variant/20 pb-4">
          <h3 class="font-headline-md text-headline-md text-on-surface">Featured Nodes</h3>
          <a href={`https://github.com/${GH_USER}?tab=repositories`} target="_blank" rel="noopener noreferrer" class="font-code-snippet text-code-snippet text-secondary hover:text-primary transition-colors flex items-center gap-2">
            VIEW_ALL <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
        {fetchFailed || featuredRepos.length === 0 ? (
          <p class="font-code-snippet text-code-snippet text-on-surface-variant text-sm">
            &gt; Live data unavailable at build time. View repos directly on <a href={`https://github.com/${GH_USER}`} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">GitHub</a>.
          </p>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {featuredRepos.map(repo => {
              const lc = langColors[repo.language ?? ''] ?? defaultLangColor;
              return (
                <a
                  href={repo.html_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="gh-repo group border border-outline-variant/20 rounded-lg p-6 bg-surface-container-lowest hover:border-primary/50 transition-all duration-300 block"
                >
                  <div class="flex justify-between items-start mb-4">
                    <h4 class="font-code-snippet text-code-snippet font-bold text-on-surface group-hover:text-primary transition-colors">
                      {repo.name}
                    </h4>
                    <span class="material-symbols-outlined text-outline-variant">terminal</span>
                  </div>
                  <p class="font-body-md text-body-md text-on-surface-variant text-sm mb-6 h-12 overflow-hidden">
                    {repo.description ?? 'No description provided.'}
                  </p>
                  <div class="flex justify-between items-center">
                    <span class={`px-2 py-1 rounded bg-[#171717] font-code-snippet text-[10px] ${lc.text} flex items-center gap-1`}>
                      <div class={`w-1.5 h-1.5 rounded-full ${lc.dot}`}></div>
                      {repo.language ?? 'N/A'}
                    </span>
                    <div class="flex gap-3 font-code-snippet text-code-snippet text-xs text-on-surface-variant">
                      <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">star</span> {repo.stargazers_count}
                      </span>
                      <span class="flex items-center gap-1">
                        <span class="material-symbols-outlined text-[14px]">fork_right</span> {repo.forks_count}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>

    </div>
  </div>
</section>

<script>
  import { fadeUp, staggerFadeUp } from '../scripts/animations.js';

  fadeUp('#github .gh-header', '#github');
  staggerFadeUp('#github .gh-card', '#github .grid');
  staggerFadeUp('#github .gh-repo', '#github .gh-repo', { stagger: 0.1, start: 'top 85%' });
</script>
