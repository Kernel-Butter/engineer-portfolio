---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Preloader from '../components/Preloader.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import '../styles/tailwind.css';
import '../styles/global.scss';

const { title = 'SYS.ENGINEER // PORTFOLIO' } = Astro.props;
---
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <ClientRouter />
  <!-- Kill Astro's built-in page crossfade - GSAP overlay handles all transitions -->
  <style>
    ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
    /* Hidden until preloader exits on first load; page-transition overlay reveals on SPA nav */
    #main-content { opacity: 0; }
  </style>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
</head>
<body class="antialiased">

  <Preloader />
  <SmoothScroll />

  <!-- Page transition overlay - fade to black + terminal blink -->
  <div id="pt-overlay" transition:persist aria-hidden="true"
       style="position:fixed;inset:0;z-index:500;pointer-events:none;visibility:hidden;background:#03030a;display:flex;align-items:center;justify-content:center;">
    <div style="display:flex;flex-direction:column;gap:10px;">
      <span id="pt-line1" style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:.10em;color:rgba(192,193,255,.85);opacity:0;white-space:nowrap;">&gt; NAVIGATING...</span>
      <span id="pt-line2" style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:.10em;color:rgba(78,222,163,.9);opacity:0;white-space:nowrap;">&gt; DONE ✓</span>
    </div>
  </div>

  <div id="main-content">
    <Nav />
    <slot />
    <footer class="bg-surface-container-lowest border-t border-outline-variant/20 py-12">
      <div class="flex flex-col md:flex-row justify-between items-center px-margin-mobile md:px-margin-desktop w-full max-w-container-max mx-auto gap-gutter">
        <div class="font-headline-md text-headline-md text-primary font-bold tracking-tighter">
          SYS.ENGINEER
        </div>
        <div class="font-code-snippet text-code-snippet text-on-surface-variant opacity-60 text-center">
          ©2026 SYS.ENGINEER // STATUS: AVAILABLE_FOR_WORK
        </div>
        <nav class="flex flex-wrap justify-center gap-6">
          <a href="https://github.com/Kernel-Butter" target="_blank" rel="noopener noreferrer" class="font-code-snippet text-code-snippet text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors">GITHUB</a>
          <a href="https://linkedin.com/in/hamzabhutta" target="_blank" rel="noopener noreferrer" class="font-code-snippet text-code-snippet text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors">LINKEDIN</a>
          <a href="#" class="font-code-snippet text-code-snippet text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors">CV_DL</a>
        </nav>
      </div>
    </footer>
  </div>

  <script>
    import Alpine from 'alpinejs';
    window.Alpine = Alpine;
    Alpine.start();
  </script>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    let _active     = false;
    let _inDone     = false;
    let _pendingOut: (() => void) | null = null;

    function markInDone() {
      _inDone = true;
      if (_pendingOut) { _pendingOut(); _pendingOut = null; }
    }

    /* Astro's client-side nav only ever re-runs each page's own <script>
       modules once (the browser's module registry is keyed by URL and
       survives the DOM swap) - but every section's ScrollTrigger-driven
       reveal is set up as a top-level call in that script. Without this,
       a section visited a second time keeps its stale ScrollTrigger bound
       to the OLD (now-detached) DOM, while the fresh DOM sits at its CSS
       opacity:0 starting state with nothing left to ever reveal it.
       Killing every ScrollTrigger right after the DOM swap (before
       astro:page-load fires and each section's own listener re-creates
       its own trigger against the fresh elements) clears that stale state. */
    document.addEventListener('astro:after-swap', () => {
      ScrollTrigger.getAll().forEach(st => st.kill());
    });

    // CMS-controlled visibility and ordering change every section's document
    // position. Refresh after all section page-load handlers have recreated
    // their triggers so animations keep matching the rendered layout.
    document.addEventListener('astro:page-load', () => {
      requestAnimationFrame(() => ScrollTrigger.refresh());
    });

    /* PHASE 1 - fade to black + "NAVIGATING" line */
    document.addEventListener('astro:before-preparation', () => {
      /* Skip if the preloader hasn't completed its first run yet - avoids a black
         flash over the preloader if Astro fires this event during initialisation. */
      if (sessionStorage.getItem('preloader_done') !== '1') return;

      _active     = true;
      _inDone     = false;
      _pendingOut = null;

      const overlay = document.getElementById('pt-overlay')!;
      const line1   = document.getElementById('pt-line1')!;
      const line2   = document.getElementById('pt-line2')!;

      gsap.set([line1, line2], { opacity: 0 });
      gsap.set(overlay, { opacity: 0, visibility: 'visible' });

      gsap.timeline({ onComplete: markInDone })
        .to(overlay, { opacity: 1, duration: 0.22, ease: 'power2.in' })
        .to(line1,   { opacity: 1, duration: 0.12, ease: 'none' }, '+=0.04')
        .to({},      { duration: 0.18 });
    });

    /* PHASE 2 - "DONE" line + fade out overlay, slide new page up */
    document.addEventListener('astro:page-load', () => {
      const main    = document.getElementById('main-content');
      const overlay = document.getElementById('pt-overlay')!;
      const line2   = document.getElementById('pt-line2')!;

      if (!_active) {
        // Full page load - preloader's onComplete handles reveal and portfolio:ready.
        // Never interfere here; firing portfolio:ready early would burn Hero's { once:true }
        // listener before the preloader exits.
        return;
      }

      document.body.style.overflow = 'auto';

      if (main) gsap.set(main, { visibility: 'visible', opacity: 1 });

      function runOut() {
        const tl = gsap.timeline({
          onComplete() {
            _active = false;
            gsap.set(overlay, { visibility: 'hidden' });
            document.dispatchEvent(new CustomEvent('portfolio:ready'));
          }
        });

        tl.to(line2,   { opacity: 1, duration: 0.12, ease: 'none' })
          .to({},      { duration: 0.28 })
          .to(overlay, { opacity: 0, duration: 0.30, ease: 'power2.out' });

        /* fromTo only sets y:32 at tween-start - overlay is still opaque then.
           clearProps strips the inline transform once settled - otherwise it
           lingers at translate3d(0,0,0) and creates a new containing block,
           breaking position:fixed for any descendant (e.g. a fixed nav rail)
           on every page reached via a client-side transition. */
        if (main) {
          tl.fromTo(main, { y: 32 }, { y: 0, duration: 0.36, ease: 'power3.out', clearProps: 'transform' }, '<+=0.06');
        }
      }

      if (_inDone) { runOut(); } else { _pendingOut = runOut; }
    });
  </script>

</body>
</html>
