---
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Preloader from '../components/Preloader.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import '../styles/tailwind.css';
import '../styles/global.scss';

const { title = 'SYS.ENGINEER // PORTFOLIO' } = Astro.props;
---
<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <ClientRouter />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
</head>
<body class="antialiased">

  <Preloader />
  <SmoothScroll />

  <!-- Page transition overlay — survives every DOM swap via transition:persist -->
  <div
    id="pt-overlay"
    transition:persist
    aria-hidden="true"
    style="position:fixed;inset:0;z-index:500;pointer-events:none;transform:translateY(100%);background:#0a0a0a;display:flex;align-items:center;justify-content:center;"
  >
    <div style="position:absolute;inset:0;background:repeating-linear-gradient(0deg,transparent,transparent 3px,rgba(192,193,255,0.012) 3px,rgba(192,193,255,0.012) 4px);pointer-events:none"></div>
    <span style="position:relative;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:rgba(192,193,255,0.3)">SYS.NAVIGATING</span>
  </div>

  <div id="main-content">
    <Nav />
    <slot />
    <footer class="bg-surface-container-lowest border-t border-outline-variant/20 py-12">
      <div class="flex flex-col md:flex-row justify-between items-center px-margin-mobile md:px-margin-desktop w-full max-w-container-max mx-auto gap-gutter">
        <div class="font-headline-md text-headline-md text-primary font-bold tracking-tighter">
          TERMINAL_VELOCITY.ENGINEER
        </div>
        <div class="font-code-snippet text-code-snippet text-on-surface-variant opacity-60 text-center">
          ©2025 TERMINAL_VELOCITY.ENGINEER // STATUS: AVAILABLE_FOR_WORK
        </div>
        <nav class="flex flex-wrap justify-center gap-6">
          <a href="#" class="font-code-snippet text-code-snippet text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors">GITHUB</a>
          <a href="#" class="font-code-snippet text-code-snippet text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors">LINKEDIN</a>
          <a href="#" class="font-code-snippet text-code-snippet text-on-surface-variant hover:text-primary underline underline-offset-4 transition-colors">CV_DL</a>
        </nav>
      </div>
    </footer>
  </div>

  <script>
    import Alpine from 'alpinejs';
    window.Alpine = Alpine;
    Alpine.start();
  </script>

  <script>
    import { initCMS } from '../scripts/cms.js';
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCMS);
    } else {
      initCMS();
    }
  </script>

  <script>
    // After the very first load the preloader is persisted (hidden via transition:persist).
    // On every subsequent ClientRouter navigation, #main-content is re-inserted
    // with opacity:0/visibility:hidden from CSS — we reveal it here.
    document.addEventListener('astro:page-load', () => {
      if (sessionStorage.getItem('preloader_done') !== '1') return;

      const main = document.getElementById('main-content');
      if (main) {
        main.style.opacity    = '1';
        main.style.visibility = 'visible';
      }
      document.body.style.overflow = 'auto';
      document.dispatchEvent(new CustomEvent('portfolio:ready'));
    });
  </script>

</body>
</html>
