---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroTelemetry from '../../sections/HeroTelemetry.astro';
import { experiments, statusMeta } from '../../data/experiments.js';
---

<BaseLayout title="Experiments // Section Compare">

  <!-- ── PAGE HEADER ───────────────────────────── -->
  <div class="px-margin-mobile md:px-margin-desktop pt-32 pb-12 max-w-container-max mx-auto">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">// DEV_EXPERIMENTS</span>
    </div>
    <h1 class="font-headline-lg text-headline-lg text-on-surface mb-3">Experiments</h1>
    <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
      Prototype section variants. Active experiment runs full-screen above — click any card below to compare variants on one page.
    </p>
  </div>

  <!-- ── ACTIVE EXPERIMENT ─────────────────────── -->
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-4">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded border border-primary/30 bg-primary/5 text-primary font-code-snippet text-[11px] uppercase tracking-widest">
      <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
      ACTIVE — HERO_TELEMETRY // Micro-Telemetry Dashboard
    </span>
  </div>
  <div class="border-y border-outline-variant/20">
    <HeroTelemetry />
  </div>

  <!-- ── DIVIDER ───────────────────────────────── -->
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto py-20">
    <div class="flex items-center gap-6">
      <div class="flex-1 h-px bg-outline-variant/15"></div>
      <span class="font-code-snippet text-[10px] text-on-surface-variant/30 uppercase tracking-[.2em]">Archive</span>
      <div class="flex-1 h-px bg-outline-variant/15"></div>
    </div>
  </div>

  <!-- ── CARD GRID ──────────────────────────────── -->
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto pb-32">

    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="font-code-snippet text-[10px] text-on-surface-variant/40 uppercase tracking-[.2em] mb-1">All Experiments</div>
        <h2 class="font-headline-md text-headline-md text-on-surface">{experiments.length} experiments</h2>
      </div>
      <div class="hidden md:flex gap-4 font-code-snippet text-[10px] text-on-surface-variant/30 uppercase tracking-widest items-center">
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-accent/50"></span>Stable</span>
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-yellow-500/50"></span>Experimental</span>
        <span class="flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-outline-variant/40"></span>Archived</span>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {experiments.map(exp => {
        const isMulti = exp.variants.length > 1;
        // badge shown on card = latest/highest-priority variant status
        const cardStatus = exp.variants.find(v => v.status === 'stable')?.status
                        ?? exp.variants.find(v => v.status === 'experimental')?.status
                        ?? exp.variants[0].status;
        const s = statusMeta[cardStatus as keyof typeof statusMeta];

        return (
          <a
            href={`/experiments/${exp.slug}`}
            class="exp-card group relative flex flex-col rounded-xl overflow-hidden border border-outline-variant/20 bg-surface-container hover:border-outline-variant/45 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_40px_rgba(0,0,0,.5)]"
          >
            <!-- Preview -->
            <div class="relative h-32 overflow-hidden flex-shrink-0" style="background:#0c0c0c">
              <div class="absolute inset-0" style={`background:${exp.bg}`}></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <span
                  class="material-symbols-outlined opacity-[.15] group-hover:opacity-[.28] transition-opacity duration-300"
                  style={`font-size:60px;color:${exp.accent};font-variation-settings:'FILL' 0,'wght' 100,'GRAD' 0,'opsz' 48`}
                >{exp.icon}</span>
              </div>

              <!-- variant count badge -->
              {isMulti && (
                <div class="absolute top-3 left-3">
                  <span
                    class="font-code-snippet text-[9px] uppercase tracking-widest px-2 py-0.5 rounded-full border"
                    style={`color:${exp.accent};border-color:${exp.accent}30;background:${exp.accent}12`}
                  >{exp.variants.length} variants</span>
                </div>
              )}

              <!-- category -->
              <div class="absolute top-3 right-3">
                <span class="font-code-snippet text-[9px] uppercase tracking-widest text-on-surface-variant/30">{exp.category}</span>
              </div>

              <!-- hover arrow -->
              <div class="absolute bottom-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity duration-150">
                <span class="material-symbols-outlined text-[15px]" style={`color:${exp.accent}`}>arrow_outward</span>
              </div>

              <!-- top accent line on hover -->
              <div
                class="absolute inset-x-0 top-0 h-px opacity-0 group-hover:opacity-100 transition-opacity duration-300"
                style={`background:linear-gradient(90deg,transparent,${exp.accent}70,transparent)`}
              ></div>
            </div>

            <!-- Body -->
            <div class="flex flex-col flex-grow p-5 gap-3">

              <!-- Title + status -->
              <div class="flex items-start justify-between gap-3">
                <h3
                  class="exp-title font-headline-sm text-headline-sm text-on-surface leading-tight"
                  style={`--accent:${exp.accent}`}
                >{exp.title}</h3>
                <span
                  class="flex-shrink-0 inline-flex items-center gap-1.5 font-code-snippet text-[9px] uppercase tracking-widest px-2 py-0.5 rounded border mt-0.5"
                  style={`color:${s.color};background:${s.bg};border-color:${s.border}`}
                >
                  <span class="w-1 h-1 rounded-full" style={`background:${s.color}`}></span>
                  {s.label}
                </span>
              </div>

              <!-- Variant list -->
              <div class="flex flex-col gap-1.5">
                {exp.variants.map((v, i) => {
                  const vs = statusMeta[v.status as keyof typeof statusMeta];
                  return (
                    <div class="flex items-center gap-2.5">
                      <span
                        class="w-1.5 h-1.5 rounded-full flex-shrink-0"
                        style={`background:${vs.color};opacity:${v.status === 'archived' ? '.4' : '1'}`}
                      ></span>
                      <span
                        class="font-code-snippet text-[10px] uppercase tracking-widest"
                        style={`color:${v.status === 'archived' ? 'rgba(255,255,255,.3)' : 'rgba(255,255,255,.6)'}`}
                      >{v.label}</span>
                    </div>
                  );
                })}
              </div>

              <!-- Desc -->
              <p class="font-body-sm text-body-sm text-on-surface-variant/50 leading-relaxed flex-grow line-clamp-2 text-[12px]">
                {exp.desc}
              </p>

              <!-- Footer -->
              <div class="flex items-center justify-between pt-3 border-t border-outline-variant/10">
                <span class="font-code-snippet text-[9px] text-on-surface-variant/30 uppercase tracking-widest">
                  {isMulti ? 'Compare variants' : 'View experiment'}
                </span>
                <span
                  class="material-symbols-outlined text-[14px] opacity-30 group-hover:opacity-90 group-hover:translate-x-0.5 transition-all duration-200"
                  style={`color:${exp.accent}`}
                >arrow_forward</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>

</BaseLayout>

<style>
  .exp-card:hover .exp-title { color: var(--accent); transition: color .2s; }
</style>
