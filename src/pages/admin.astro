---
export const prerender = true;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Portfolio Content Manager</title>
    <style>
      html, body { margin: 0; min-height: 100%; background: #f6f7f9; }
    </style>
  </head>
  <body>
    <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
    <script is:inline>
      (() => {
        const { CMS, createClass, h } = window;
        if (!CMS || !createClass || !h) return;

        const text = value => value == null ? '' : String(value);
        const list = value => Array.isArray(value) ? value : [];

        const Preview = createClass({
          render() {
            const rawData = this.props.entry.get('data')?.toJS?.() ?? {};
            const data = rawData.section?.type ? rawData.section : rawData;
            const asset = path => {
              const item = path && this.props.getAsset(path);
              return item?.url ?? item?.toString?.() ?? path;
            };
            const isLayout = Array.isArray(data.sections);
            const heading = isLayout ? 'Home Page Layout' : data.sectionTitle || data.name || [data.headlinePrefix, data.headlineAccent].filter(Boolean).join(' ') || [data.headlineLine1, data.headlineLine2].filter(Boolean).join(' ') || 'Section preview';
            const intro = data.sectionSubtitle || data.subheadline || '';
            const groups = list(data.sections || data.navigation || data.projects || data.items || data.roles || data.categories || data.cards).filter(item => isLayout || item.visible !== false);

            return h('main', { style: { minHeight: '100%', padding: '48px 36px', background: '#0b0b0b', color: '#d7d8df', fontFamily: 'Inter, system-ui, sans-serif' } },
              h('section', { style: { maxWidth: '920px', margin: '0 auto' } },
                h('div', { style: { color: '#44e2cd', font: '600 12px ui-monospace, monospace', letterSpacing: '.12em', marginBottom: '14px' } }, text(data.sectionLabel || data.eyebrow || data.statusBadge)),
                h('h1', { style: { color: '#c0c1ff', fontSize: 'clamp(32px, 6vw, 68px)', lineHeight: '1', margin: '0 0 22px', letterSpacing: '-.04em' } }, text(heading)),
                intro && h('p', { style: { color: '#a6a8b0', fontSize: '17px', lineHeight: '1.7', maxWidth: '720px', marginBottom: '34px' } }, text(intro)),
                data.tagline && h('p', { style: { color: '#44e2cd', font: '14px ui-monospace, monospace', marginBottom: '24px' } }, text(data.tagline)),
                (data.ctaLabel || data.statusLabel) && h('div', { style: { display: 'flex', alignItems: 'center', gap: '16px', flexWrap: 'wrap', marginBottom: '30px' } },
                  data.ctaLabel && h('span', { style: { padding: '12px 18px', borderRadius: '6px', background: '#c0c1ff', color: '#0b0b0b', fontWeight: '700' } }, text(data.ctaLabel)),
                  data.statusLabel && h('span', { style: { color: '#a6a8b0', font: '12px ui-monospace, monospace' } }, text(data.statusLabel))
                ),
                data.ctaHref && h('div', { style: { color: '#777b86', fontSize: '11px', margin: '-20px 0 28px' } }, `Button link: ${text(data.ctaHref)}`),
                data.image && h('img', { src: asset(data.image), alt: text(data.imageAlt), style: { width: '100%', borderRadius: '14px', marginBottom: '24px' } }),
                data.metric && h('div', { style: { display: 'inline-block', padding: '12px 18px', border: '1px solid #44e2cd55', borderRadius: '999px', color: '#44e2cd', marginBottom: '24px' } }, text(data.metric)),
                data.metricTitle && h('h2', { style: { color: '#c0c1ff', marginBottom: '8px' } }, text(data.metricTitle)),
                data.metricDescription && h('p', { style: { color: '#a6a8b0', lineHeight: '1.65', marginBottom: '28px' } }, text(data.metricDescription)),
                groups.length > 0 && h('div', { style: { display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(220px,1fr))', gap: '16px' } },
                  ...groups.map((item, index) => h('article', { key: index, style: { border: '1px solid #ffffff18', background: '#151515', borderRadius: '12px', padding: '20px', overflow: 'hidden' } },
                    item.image && h('img', { src: asset(item.image), alt: text(item.imageAlt), style: { width: 'calc(100% + 40px)', height: '150px', objectFit: 'cover', margin: '-20px -20px 18px' } }),
                    h('div', { style: { color: item.visible === false ? '#ff7777' : '#44e2cd', font: '12px ui-monospace, monospace', marginBottom: '8px' } }, text(isLayout ? (item.visible === false ? 'HIDDEN' : 'VISIBLE') : item.icon || item.initials || item.period || item.category || item.label || item.role)),
                    h('h2', { style: { color: '#c0c1ff', fontSize: '20px', margin: '0 0 10px' } }, text(item.label || item.section || item.name || item.title || item.company)),
                    item.location && h('p', { style: { color: '#777b86', fontSize: '12px', margin: '0 0 10px' } }, text(item.location)),
                    item.company && item.title && h('p', { style: { color: '#d7d8df', fontSize: '13px', margin: '0 0 10px' } }, text(item.company)),
                    h('p', { style: { color: '#a6a8b0', lineHeight: '1.55', margin: 0 } }, text(item.description || item.quote)),
                    (item.points || item.bullets || item.highlights) && h('ul', { style: { color: '#a6a8b0', lineHeight: '1.55', paddingLeft: '18px' } },
                      ...list(item.points || item.bullets || item.highlights).map((point, pointIndex) => h('li', { key: pointIndex, style: { marginBottom: '6px' } }, text(point)))
                    ),
                    (item.chips || item.tags || item.tech) && h('div', { style: { display: 'flex', flexWrap: 'wrap', gap: '6px', marginTop: '16px' } },
                      ...list(item.chips || item.tags || item.tech).map((chip, chipIndex) => h('span', { key: chipIndex, style: { padding: '5px 8px', border: '1px solid #ffffff18', borderRadius: '5px', fontSize: '11px' } }, text(chip)))
                    ),
                    item.href && h('a', { href: item.href, style: { display: 'inline-block', color: '#44e2cd', marginTop: '14px', fontSize: '12px' } }, text(item.href))
                  ))
                ),
                data.bookCallTitle && h('div', { style: { border: '1px solid #ffffff18', background: '#151515', borderRadius: '12px', padding: '24px', marginTop: '24px' } },
                  h('h2', { style: { color: '#c0c1ff', marginTop: 0 } }, text(data.bookCallTitle)),
                  h('p', { style: { color: '#a6a8b0' } }, text(data.bookCallSubtitle))
                ),
                data.hint && h('p', { style: { color: '#44e2cd', marginTop: '24px' } }, text(data.hint)),
                (data.githubHref || data.linkedinHref || data.cvHref || data.bookCallHref || data.contactEmail) && h('div', { style: { display: 'flex', flexDirection: 'column', gap: '8px', marginTop: '18px', fontSize: '12px' } },
                  ...[data.githubHref, data.linkedinHref, data.cvHref, data.bookCallHref, data.contactEmail].filter(Boolean).map((url, index) => h('span', { key: index, style: { color: '#a6a8b0' } }, text(url)))
                ),
                data.formTitle && h('h2', { style: { color: '#c0c1ff', marginTop: '28px' } }, text(data.formTitle)),
                data.emptyMessage && h('div', { style: { border: '1px solid #ffffff18', borderRadius: '12px', padding: '40px', textAlign: 'center', color: '#a6a8b0' } }, text(data.emptyMessage))
              )
            );
          }
        });

        ['global', 'pageLayout', 'hero', 'valueProposition', 'projects', 'techStack', 'career', 'aiWorkflow', 'writing', 'standards', 'testimonials', 'contact', 'projects_page']
          .forEach(name => CMS.registerPreviewTemplate(name, Preview));
      })();
    </script>
  </body>
</html>
