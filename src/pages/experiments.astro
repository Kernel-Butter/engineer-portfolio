---
import BaseLayout from '../layouts/BaseLayout.astro';
import AiWorkflow from '../sections/AiWorkflow.astro';
import AiWorkflowPipeline from '../sections/AiWorkflowPipeline.astro';
import TechStack from '../sections/TechStack.astro';
import TechStackV2 from '../sections/TechStackV2.astro';
---

<BaseLayout title="Experiments // Section Compare">

  <!-- Page header -->
  <div class="px-margin-mobile md:px-margin-desktop pt-32 pb-12 max-w-container-max mx-auto">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
      <span class="font-label-sm text-label-sm text-secondary uppercase tracking-widest">// DEV_EXPERIMENTS</span>
    </div>
    <h1 class="font-headline-lg text-headline-lg text-on-surface mb-3">Section Compare</h1>
    <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">
      Side-by-side iteration view. Scroll through both versions and pick the one that ships.
    </p>
  </div>

  <!-- ── AI Workflow ──────────────────────────────────────────────────────── -->

  {[
    { label: 'V1 — Terminal',       accent: false },
  ].map(({ label, accent }) => (
    <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-4">
      <span class={`inline-flex items-center gap-2 px-3 py-1 rounded border font-code-snippet text-[11px] uppercase tracking-widest ${accent ? 'border-tertiary/30 bg-tertiary/5 text-tertiary' : 'border-outline-variant/30 bg-surface-container text-on-surface-variant'}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${accent ? 'bg-tertiary animate-pulse' : 'bg-outline-variant'}`}></span>
        {label}
      </span>
    </div>
  ))}
  <div class="border-y border-outline-variant/20"><AiWorkflow /></div>

  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto py-10 flex items-center gap-4">
    <div class="flex-1 h-px bg-outline-variant/20"></div>
    <span class="font-code-snippet text-[11px] text-on-surface-variant/40 uppercase tracking-widest shrink-0">vs</span>
    <div class="flex-1 h-px bg-outline-variant/20"></div>
  </div>

  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-4">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded border border-tertiary/30 bg-tertiary/5 text-tertiary font-code-snippet text-[11px] uppercase tracking-widest">
      <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
      V2 — Pipeline Graph
    </span>
  </div>
  <div class="border-y border-outline-variant/20"><AiWorkflowPipeline /></div>

  <!-- ── Divider between experiment groups ───────────────────────────────── -->
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto py-16 flex items-center gap-4">
    <div class="flex-1 h-px bg-outline-variant/10"></div>
    <span class="font-code-snippet text-[11px] text-on-surface-variant/20 uppercase tracking-widest shrink-0">next experiment</span>
    <div class="flex-1 h-px bg-outline-variant/10"></div>
  </div>

  <!-- ── Tech Stack ───────────────────────────────────────────────────────── -->

  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-4">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded border border-outline-variant/30 bg-surface-container text-on-surface-variant font-code-snippet text-[11px] uppercase tracking-widest">
      <span class="w-1.5 h-1.5 rounded-full bg-outline-variant"></span>
      V1 — Anonymous Constellation
    </span>
  </div>
  <div class="border-y border-outline-variant/20"><TechStack /></div>

  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto py-10 flex items-center gap-4">
    <div class="flex-1 h-px bg-outline-variant/20"></div>
    <span class="font-code-snippet text-[11px] text-on-surface-variant/40 uppercase tracking-widest shrink-0">vs</span>
    <div class="flex-1 h-px bg-outline-variant/20"></div>
  </div>

  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto mb-4">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded border border-tertiary/30 bg-tertiary/5 text-tertiary font-code-snippet text-[11px] uppercase tracking-widest">
      <span class="w-1.5 h-1.5 rounded-full bg-tertiary animate-pulse"></span>
      V2 — Labeled Dev Cycle Graph
    </span>
  </div>
  <div class="border-y border-outline-variant/20"><TechStackV2 /></div>

</BaseLayout>
